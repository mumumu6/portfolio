{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/oxlint-config-presets/@typescript-eslint/strict.json"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "warn",
    "perf": "warn"
  },
  "env": {
    "astro": true,
    "browser": true,
    "node": true
  },
  "rules": {
    "unicorn/no-useless-spread": "off"
  }
}
