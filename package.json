{
  "name": "mumumu-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build:ci": "pnpm validate:ai && pnpm lint && pnpm fmt:check && pnpm check && pnpm build",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "workers:deploy": "wrangler deploy",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "oxlint src scripts",
    "lint:fix": "oxlint src scripts --fix",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "validate:ai": "node scripts/validate-ai-content.mjs",
    "sync:blog": "node scripts/sync-blog.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/ibm-plex-sans-jp": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "astro": "7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@vite-pwa/astro": "1.2.0",
    "fast-xml-parser": "5.2.5",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "workbox-window": "^7.4.1",
    "wrangler": "4.120.0"
  },
  "packageManager": "pnpm@12.0.0"
}
