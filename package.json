{
  "name": "mumumu-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build:ci": "pnpm validate:ai && pnpm lint && pnpm fmt:check && pnpm check && pnpm build",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "workers:deploy": "wrangler deploy",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "oxlint src scripts",
    "lint:fix": "oxlint src scripts --fix",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "validate:ai": "node scripts/validate-ai-content.mjs",
    "sync:blog": "node scripts/sync-blog.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/space-grotesk": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@vite-pwa/astro": "1.2.0",
    "fast-xml-parser": "5.11.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "2.0.0",
    "workbox-window": "^7.4.1",
    "wrangler": "4.147.0"
  },
  "packageManager": "pnpm@12.9.1",
  "lint-staged": {
    "*.{js,mjs,ts,astro,css,md,json,yml,yaml}": [
      "prettier --write"
    ],
    "*.{js,mjs,ts}": [
      "oxlint --fix"
    ]
  }
}
