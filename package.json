{
  "name": "mumumu-portfolio",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:ci": "pnpm validate:ai && pnpm check && pnpm build",
    "deploy": "wrangler deploy",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "validate:ai": "node scripts/validate-ai-content.mjs",
    "sync:blog": "node scripts/sync-blog.mjs"
  },
  "dependencies": {
    "astro": "7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "fast-xml-parser": "5.2.5",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "wrangler": "4.120.0"
  }
}
