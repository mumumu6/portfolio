{
  "name": "mumumu-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build:ci": "vp run validate:ai && vp run check && vp run build",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "perf": "vp run build && vp exec lhci autorun --config=./lighthouserc.json",
    "workers:deploy": "wrangler deploy",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "vp check && ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "vp lint src scripts",
    "lint:fix": "vp lint src scripts --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "validate:ai": "vpx scripts/validate-ai-content.mjs",
    "sync:blog": "vpx scripts/sync-blog.mjs",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/space-grotesk": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/compiler-rs": "^0.5.2",
    "@lhci/cli": "0.15.1",
    "@vite-pwa/astro": "1.2.0",
    "fast-xml-parser": "5.11.2",
    "oxlint-config-presets": "^0.1.21",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plugin-pwa": "2.0.0",
    "vite-plus": "catalog:",
    "workbox-window": "^7.4.1",
    "wrangler": "4.147.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1"
}
