---
import Avatar from './Avatar.astro';
import ReplyDisclosure from './ReplyDisclosure.astro';
import type { AuthorId, FeedEntry as FeedEntryType } from '../data/content';

type Props = {
  entry: FeedEntryType;
  showReplies?: boolean;
  priority?: boolean;
};

const { entry, showReplies = true, priority = false } = Astro.props;

const authors: Record<AuthorId, { name: string; ai?: boolean }> = {
  mumumu: { name: 'mumumu' },
  chatgpt: { name: 'ChatGPT', ai: true },
  codex: { name: 'Codex', ai: true },
};

const author = authors[entry.author];
const external = entry.href?.startsWith('http');
const sourceHref = entry.sourceHref ?? entry.href;
const sourceExternal = sourceHref?.startsWith('http');
const sourceUrl = sourceHref
  ? sourceExternal
    ? new URL(sourceHref)
    : new URL(sourceHref, 'https://mumumu6.net')
  : undefined;
const sourceLabel = sourceUrl
  ? entry.sourceLabel ?? `${sourceUrl.hostname.replace(/^www\./, '')}${sourceUrl.pathname.replace(/\/$/, '')}`
  : undefined;
const imageSizes = entry.kind === 'blog'
  ? '(max-width: 480px) calc(100vw - 76px), (max-width: 760px) calc(100vw - 82px), 280px'
  : '(max-width: 480px) 92px, (max-width: 760px) 145px, 280px';
---

<article class:list={['feed-entry', `feed-entry--${entry.kind}`, `feed-entry--author-${entry.author}`]}>
  <div class="entry-grid">
    <div class="entry-rail">
      <Avatar author={entry.author} />
      <span class="entry-line" aria-hidden="true"></span>
    </div>

    <div class="entry-content">
      <header class="entry-head">
        <div class="entry-author">
          <strong>{author.name}</strong>
          {author.ai && entry.kind !== 'thought' && <span class="ai-label">AI</span>}
          <span aria-hidden="true">·</span>
          <time datetime={entry.date}>{entry.dateLabel}</time>
          {entry.kind === 'blog' && entry.readingMinutes && (
            <><span aria-hidden="true">·</span><span aria-label={`推定読了時間 約${entry.readingMinutes}分`}>約{entry.readingMinutes}分</span></>
          )}
        </div>
      </header>

      {entry.title && (
        entry.href ? (
          <h2 class="entry-title">
            <a href={entry.href} target={external ? '_blank' : undefined} rel={external ? 'noreferrer' : undefined}>
              {entry.title}
            </a>
          </h2>
        ) : (
          <h2 class="entry-title">{entry.title}</h2>
        )
      )}

      <p class="entry-body">{entry.body}</p>

      {sourceHref && sourceLabel && (
        <a
          class="entry-source"
          href={sourceHref}
          target={sourceExternal ? '_blank' : undefined}
          rel={sourceExternal ? 'noreferrer' : undefined}
        >
          <span aria-hidden="true">{sourceExternal ? '↗' : '→'}</span> {sourceLabel}
        </a>
      )}

      {entry.image && (
        entry.href ? (
          <a
            class:list={['ogp-preview', `ogp-preview--${entry.kind}`]}
            href={entry.href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noreferrer' : undefined}
            aria-label={`${entry.title ?? '記事'}を開く`}
          >
            <img
              src={entry.image.src}
              srcset={entry.image.srcset?.map((source) => `${source.src} ${source.width}w`).join(', ')}
              alt={entry.image.alt}
              width={entry.image.width}
              height={entry.image.height}
              sizes={imageSizes}
              loading={priority ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={priority ? 'high' : undefined}
            />
          </a>
        ) : (
          <div class:list={['ogp-preview', `ogp-preview--${entry.kind}`]}>
            <img
              src={entry.image.src}
              srcset={entry.image.srcset?.map((source) => `${source.src} ${source.width}w`).join(', ')}
              alt={entry.image.alt}
              width={entry.image.width}
              height={entry.image.height}
              sizes={imageSizes}
              loading={priority ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={priority ? 'high' : undefined}
            />
          </div>
        )
      )}

      {entry.tags && entry.tags.length > 0 && (
        <ul class="tag-list" aria-label="タグ">
          {entry.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}

      {entry.href && !entry.image && (
        <a
          class="entry-link"
          href={entry.href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noreferrer' : undefined}
        >
          {entry.linkLabel ?? '詳しく見る'}<span aria-hidden="true"> →</span>
        </a>
      )}

      {showReplies && entry.replies && entry.replies.length > 0 && (
        <ReplyDisclosure replies={entry.replies} label={entry.kind === 'thought' ? '返信' : 'AIのコメント'} />
      )}
    </div>
  </div>
</article>
