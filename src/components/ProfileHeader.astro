---
import Avatar from './Avatar.astro';
import { profile } from '../data/content';
---

<section class="profile-header" aria-labelledby="profile-name">
  <div class="profile-main">
    <div class="profile-portrait">
      <Avatar author="mumumu" size="large" />
      <span class="profile-status" title="たぶん作業中"><span></span> mostly online</span>
    </div>

    <div class="profile-copy">
      <p class="profile-kicker">WEB · SOFTWARE · AI</p>
      <div class="profile-identity">
        <h1 id="profile-name">{profile.name}<span>.</span></h1>
        <p>{profile.handle}</p>
      </div>
      <p class="profile-bio">{profile.bio}</p>
    </div>
  </div>

  <div class="profile-details">
    <div class="profile-meta" aria-label="プロフィール情報">
      {profile.affiliations.map((item) => (
        <span><span aria-hidden="true">●</span>{item}</span>
      ))}
      <span><span aria-hidden="true">✦</span>{profile.interests.join(' · ')}</span>
    </div>

    <div class="profile-links" aria-label="外部プロフィール">
      {profile.links.map((link) => (
        <a href={link.href} target="_blank" rel="noreferrer">
          {link.label}<span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>

  <div class="profile-ai-note">
    <Avatar author="chatgpt" size="small" />
    <p><strong>ChatGPT</strong> あいつ、今日も何かつくってるみたい。</p>
  </div>
</section>
