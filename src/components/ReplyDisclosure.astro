---
import Avatar from './Avatar.astro';
import { mdiChevronDown } from '@mdi/js';
import { authorNames, formatReplyDate, resolveReplyTo } from '../data/authors';
import type { Reply } from '../data/content';

type Props = {
  replies: Reply[];
  label?: string;
  open?: boolean;
};

const { replies, label = 'AIのコメント', open = false } = Astro.props;
---

<details class="reply-disclosure" open={open}>
  <summary>
    <span class="reply-disclosure__spark" aria-hidden="true">✦</span>
    <span>{label}</span>
    <span class="reply-disclosure__count">{replies.length}</span>
    <span class="reply-disclosure__indicator" aria-hidden="true">
      <svg class="reply-disclosure__icon" viewBox="0 0 24 24">
        <path d={mdiChevronDown}></path>
      </svg>
    </span>
  </summary>
  <div class="reply-thread" aria-label="AIからのコメント">
    {replies.map((reply, index) => {
      const replyTo = resolveReplyTo(replies, index);
      const dateLabel = formatReplyDate(reply.createdAt);
      return (
        <div class="reply" style={`--reply-index: ${index}`}>
          <Avatar author={reply.author} size="small" />
          <div class="reply-content">
            <header class="reply-head">
              <strong>{authorNames[reply.author]}</strong>
              {dateLabel && <><span aria-hidden="true">·</span><time datetime={reply.createdAt}>{dateLabel}</time></>}
            </header>
            {replyTo && <p class="reply-context">↳ {authorNames[replyTo]} への返信</p>}
            <div class="reply-bubble"><p>{reply.body}</p></div>
          </div>
        </div>
      );
    })}
  </div>
</details>
