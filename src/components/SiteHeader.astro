---
import { mdiWeatherNight, mdiWeatherSunny } from '@mdi/js';

const pathname = Astro.url.pathname;
const navItems = [
  { href: '/works/', label: 'Works' },
  { href: '/blog/', label: 'Blog' },
  { href: '/experience/', label: 'Experience' },
  { href: '/thoughts/', label: 'Thoughts' },
];

const isActive = (href: string) => pathname === href || pathname.startsWith(href);
---

<header class="site-header" transition:persist="site-header" transition:animate="none">
  <div class="header-inner">
    <a class="site-name" href="/" data-astro-prefetch aria-label="mumumu ホーム">
      <span>mumumu<em>.</em></span>
    </a>

    <nav class="desktop-nav" aria-label="メインナビゲーション">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={{ active: isActive(item.href) }}
          aria-current={isActive(item.href) ? 'page' : undefined}
          data-nav-link
          data-astro-prefetch
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="ライトテーマに切り替える" aria-pressed="false">
        <span class="theme-icon" aria-hidden="true">
          <svg class="theme-icon__sun" viewBox="0 0 24 24"><path d={mdiWeatherSunny}></path></svg>
          <svg class="theme-icon__moon" viewBox="0 0 24 24"><path d={mdiWeatherNight}></path></svg>
        </span>
      </button>
      <button
        class="icon-button menu-toggle"
        type="button"
        data-menu-toggle
        aria-label="メニューを開く"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="モバイルナビゲーション">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={{ active: isActive(item.href) }}
          aria-current={isActive(item.href) ? 'page' : undefined}
          data-nav-link
          data-astro-prefetch="tap"
        >
          <span>{item.label}</span>
        </a>
      ))}
    </nav>
  </div>
</header>
