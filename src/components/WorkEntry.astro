---
import Avatar from './Avatar.astro';
import ReplyDisclosure from './ReplyDisclosure.astro';
import type { WorkEntry as WorkEntryType } from '../data/content';

type Props = {
  entry: WorkEntryType;
};

const { entry } = Astro.props;
const statusLabels = { active: 'ACTIVE', paused: 'PAUSED', archived: 'ARCHIVED' } as const;
const statusLabel = statusLabels[entry.status];
---

<article class="feed-entry work-entry">
  <div class="entry-grid">
    <div class="entry-rail">
      <Avatar author="mumumu" />
    </div>

    <div class="entry-content">
      <header class="entry-head">
        <div class="entry-author">
          <strong>mumumu</strong>
          <span aria-hidden="true">·</span>
          <time datetime={entry.date}>{entry.dateLabel}</time>
          <span aria-hidden="true">·</span>
          <span class:list={['work-status', `work-status--${entry.status}`]}>{statusLabel}</span>
        </div>
      </header>

      <h2 class="entry-title">
        <a href={entry.href}>{entry.title}</a>
      </h2>
      <p class="entry-body">{entry.body}</p>

      <a class="ogp-preview ogp-preview--work" href={entry.href} aria-label={`${entry.title}の詳細を見る`}>
        <img
          src={entry.image.src}
          alt={entry.image.alt}
          width={entry.image.width}
          height={entry.image.height}
          sizes="(max-width: 480px) calc(100vw - 92px), (max-width: 760px) 145px, 280px"
          loading="lazy"
          decoding="async"
        />
      </a>

      <ul class="tag-list" aria-label="使用技術">
        {entry.tags?.map((tag) => <li>{tag}</li>)}
      </ul>

      <a class="work-note-preview" href={entry.href} aria-label={`${entry.title}の制作メモを読む`}>
        <Avatar author="mumumu" size="small" />
        <span>
          <strong>制作メモ</strong>
          <span>{entry.note}</span>
        </span>
      </a>

      <a class="entry-link" href={entry.href}>詳細を見る<span aria-hidden="true"> →</span></a>

      {entry.replies && entry.replies.length > 0 && <ReplyDisclosure replies={entry.replies} />}
    </div>
  </div>
</article>
