---
import ArticleTocList from '@/components/article/ArticleTocList.astro'
import Disclosure from '@/components/common/Disclosure.astro'
import pageStyles from '@/styles/pages/blog.module.css'
import proseStyles from '@/styles/components/article-prose.module.css'
import { mdiArrowUp } from '@mdi/js'

type Heading = { depth: number; slug: string; text: string }

interface Props {
  articleId: string
  headings: Heading[]
}

const { articleId, headings } = Astro.props
const showToc = headings.length > 2
---

<div data-article-controls data-article-id={articleId}>
  <button
    class={pageStyles.readingProgress}
    data-reading-progress
    data-scroll-to-top
    type="button"
    aria-label="ページの先頭へ戻る"
  >
    <svg
      class={pageStyles.readingProgressRing}
      viewBox="0 0 48 48"
      aria-hidden="true"
    >
      <circle
        class={pageStyles.readingProgressTrack}
        cx="24"
        cy="24"
        r="22"
      ></circle>
      <circle
        class={pageStyles.readingProgressValue}
        cx="24"
        cy="24"
        r="22"
        pathLength="100"
      ></circle>
    </svg>
    <svg
      class={pageStyles.readingProgressArrow}
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d={mdiArrowUp}></path>
    </svg>
  </button>
  {showToc && (
    <Disclosure class={pageStyles.articleTocMobile ?? ''}>
      <span slot="summary">目次</span>
      <small slot="summary">{headings.length}項目</small>
      <nav aria-label="目次">
        <ArticleTocList headings={headings} />
      </nav>
    </Disclosure>
  )}
  <div class={pageStyles.articleLayout}>
    {showToc && (
      <nav class={pageStyles.articleToc} aria-label="目次">
        <div class={pageStyles.articleTocHead}>
          <strong>目次</strong>
        </div>
        <ArticleTocList headings={headings} />
      </nav>
    )}
    <div class={proseStyles.articleProse} data-article-prose>
      <slot />
    </div>
  </div>
</div>
