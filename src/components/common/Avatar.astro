---
import styles from '@/styles/components/avatar.module.css'
import type { AuthorId } from '@/repository/shared'
import type { ImageMetadata } from 'astro'
import ResponsiveImage from '@/components/common/ResponsiveImage.astro'
import codexIcon from '@/assets/icons/codex-256.webp'
import mumumuIcon from '@/assets/icons/mumumu-256.webp'
import openaiIcon from '@/assets/icons/openai-256.webp'
import grokIcon from '@/assets/icons/grok-256.webp'

type Props = {
  author: AuthorId
  size?: 'large' | 'medium' | 'small'
}

const { author, size = 'medium' } = Astro.props

const icons: Record<AuthorId, ImageMetadata> = {
  mumumu: mumumuIcon,
  chatgpt: openaiIcon,
  codex: codexIcon,
  grok: grokIcon,
}

const dimension = size === 'large' ? 112 : size === 'medium' ? 48 : 32
const widths =
  size === 'large' ? [128, 256] : size === 'medium' ? [64, 128] : [64]
---

<span class={styles.avatar} data-avatar={author} data-avatar-size={size}>
  <ResponsiveImage
    fit={author === 'chatgpt' ? 'contain' : 'cover'}
    src={icons[author]}
    widths={widths}
    sizes={`${dimension}px`}
    alt=""
    width={dimension}
    height={dimension}
    loading={size === 'large' ? 'eager' : 'lazy'}
  />
</span>
