---
import '@/styles/components/external-link-card.css';

type Props = {
  href: string;
  label: string;
  host: string;
  className?: string;
};

const { href, label, host, className } = Astro.props;
---

<a class:list={['external-card-link', className]} href={href} target="_blank" rel="noreferrer">
  <span>
    <strong>{label}</strong>
    <small>{host}</small>
  </span>
  <span class="external-card-link__arrow" aria-hidden="true">↗</span>
</a>
