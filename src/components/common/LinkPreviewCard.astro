---
import styles from '@/styles/components/external-link-card.module.css'
import ResponsiveImage from '@/components/common/ResponsiveImage.astro'
import { getOgp } from '@/repository/astro/ogp'

type Props = {
  href: string
  label?: string
  imageRatio?: number
}

const { href, label, imageRatio } = Astro.props
const url = new URL(href)
const ogp = await getOgp(href)
const title = ogp.title ?? label ?? url.hostname
const host = ogp.siteName ?? url.hostname
const resolvedImageRatio =
  imageRatio ??
  (ogp.imageWidth && ogp.imageHeight
    ? ogp.imageWidth / ogp.imageHeight
    : 16 / 9)
const optimizedImageWidth = 640
const optimizedImageHeight = Math.round(
  optimizedImageWidth / resolvedImageRatio,
)
---

<a
  class:list={[
    styles.externalCardLink,
    styles.linkPreviewCard,
    ogp.image && styles.linkPreviewCardWithImage,
  ]}
  style={
    resolvedImageRatio ? `--link-image-ratio: ${resolvedImageRatio}` : undefined
  }
  href={href}
  target="_blank"
  rel="noopener noreferrer"
>
  {ogp.image && (
    <span class={styles.linkPreviewCardThumbnail} aria-hidden="true">
      <ResponsiveImage
        fit="contain"
        src={ogp.image}
        alt=""
        width={optimizedImageWidth}
        height={optimizedImageHeight}
        widths={[optimizedImageWidth]}
        sizes={`${optimizedImageWidth}px`}
        quality="low"
        loading="lazy"
        className={styles.linkPreviewCardImage}
      />
    </span>
  )}
  <span class={styles.linkPreviewCardBody}>
    <strong>{title}</strong>
    {ogp.description && (
      <span class={styles.linkPreviewCardDescription}>{ogp.description}</span>
    )}
    <small>{host}</small>
  </span>
</a>
