---
import '@/styles/components/external-link-card.css'
import ResponsiveImage from '@/components/common/ResponsiveImage.astro'
import { getOgp } from '@/lib/portfolio/ogp'

type Props = {
  href: string
  label?: string
  imageRatio?: number
}

const { href, label, imageRatio } = Astro.props
const url = new URL(href)
const ogp = await getOgp(href)
const title = ogp.title ?? label ?? url.hostname
const host = ogp.siteName ?? url.hostname
const resolvedImageRatio =
  imageRatio ??
  (ogp.imageWidth && ogp.imageHeight
    ? ogp.imageWidth / ogp.imageHeight
    : 16 / 9)
const optimizedImageWidth = 640
const optimizedImageHeight = Math.round(
  optimizedImageWidth / resolvedImageRatio,
)
---

<a
  class:list={[
    'external-card-link',
    'link-preview-card',
    { 'link-preview-card--with-image': ogp.image },
  ]}
  style={resolvedImageRatio
    ? `--link-image-ratio: ${resolvedImageRatio}`
    : undefined}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
>
  {
    ogp.image && (
      <span class="link-preview-card__thumbnail" aria-hidden="true">
        <ResponsiveImage
          className="link-preview-card__image"
          src={ogp.image}
          alt=""
          width={optimizedImageWidth}
          height={optimizedImageHeight}
          widths={[optimizedImageWidth]}
          sizes={`${optimizedImageWidth}px`}
          quality="mid"
          loading="lazy"
        />
      </span>
    )
  }
  <span class="link-preview-card__body">
    <strong>{title}</strong>
    {
      ogp.description && (
        <span class="link-preview-card__description">{ogp.description}</span>
      )
    }
    <small>{host}</small>
  </span>
</a>
