---
import { getImage, Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import '@/styles/components/responsive-image.css'

type Props = {
  transitionName?: string | undefined
  src: ImageMetadata | string
  alt: string
  width?: number | undefined
  height?: number | undefined
  sizes?: string | undefined
  widths?: number[] | undefined
  quality?: 'low' | 'mid' | 'high' | 'max' | number | undefined
  loading?: 'lazy' | 'eager' | undefined
  fetchPriority?: 'high' | 'low' | 'auto' | undefined
  className?: string | undefined
}

const {
  src,
  transitionName,
  alt,
  width,
  height,
  sizes = '100vw',
  widths: customWidths,
  quality,
  loading = 'lazy',
  fetchPriority = 'low',
  className,
} = Astro.props

const isRemoteImage = typeof src === 'string'

if (isRemoteImage && (width === undefined || height === undefined)) {
  throw new Error(
    'ResponsiveImage requires width and height for remote image sources.',
  )
}

const sourceWidth = isRemoteImage ? width : src.width
const sourceHeight = isRemoteImage ? height : src.height
const resolvedWidth = width ?? sourceWidth
const resolvedHeight = height ?? sourceHeight

if (resolvedWidth === undefined || resolvedHeight === undefined) {
  throw new Error('ResponsiveImage could not determine the image dimensions.')
}

const maximumGeneratedWidth = Math.min(sourceWidth ?? 2400, 2400)
const defaultWidths = [
  ...new Set(
    [480, 960, 1440, 1920, 2400, maximumGeneratedWidth].filter(
      (candidate) => candidate <= maximumGeneratedWidth,
    ),
  ),
]
const widths = customWidths ?? defaultWidths
const fallbackWidth = Math.min(resolvedWidth, maximumGeneratedWidth)
const fallbackHeight = Math.round(
  (fallbackWidth * resolvedHeight) / resolvedWidth,
)
const imageProps =
  typeof src === 'string'
    ? {
        src,
        width: fallbackWidth,
        height: fallbackHeight,
        inferSize: false as const,
      }
    : { src, width: fallbackWidth, height: fallbackHeight }
const imageOptions = {
  ...imageProps,
  widths,
  layout: 'none' as const,
  ...(quality === undefined ? {} : { quality }),
}
const optimized =
  alt === ''
    ? undefined
    : await Promise.all([
        getImage({ ...imageOptions, format: 'avif' }),
        getImage({ ...imageOptions, format: 'webp' }),
      ])
const pictureProps = optimized
  ? {
      image: {
        src: optimized[1].src,
        avifSrcset: optimized[0].srcSet.attribute || optimized[0].src,
        webpSrcset: optimized[1].srcSet.attribute,
        alt,
        width: fallbackWidth,
        height: fallbackHeight,
        sizes,
        loading,
        fetchPriority,
      },
      class: className,
      style: transitionName
        ? `view-transition-name: ${transitionName}`
        : undefined,
    }
  : undefined
---

{pictureProps ? (
  <div
    class:list={['optimized-image', className]}
    data-optimized-image
    data-image-state="loading"
    data-image-in-view={loading === 'eager' ? 'true' : undefined}
    style={pictureProps.style}
  >
    <picture data-progressive-image>
      <source
        type="image/avif"
        srcset={pictureProps.image.avifSrcset}
        sizes={pictureProps.image.sizes}
      />
      <img
        src={pictureProps.image.src}
        srcset={pictureProps.image.webpSrcset || undefined}
        alt={pictureProps.image.alt}
        width={pictureProps.image.width}
        height={pictureProps.image.height}
        sizes={pictureProps.image.sizes}
        loading={pictureProps.image.loading}
        fetchpriority={pictureProps.image.fetchPriority}
        decoding="async"
        data-progressive-image
      />
    </picture>
    <div class="responsive-image__skeleton" aria-hidden="true"></div>
  </div>
) : (
  <Picture
    {...imageProps}
    alt={alt}
    widths={widths}
    sizes={sizes}
    {...(quality === undefined ? {} : { quality })}
    formats={['avif']}
    fallbackFormat="webp"
    layout="none"
    loading={loading}
    decoding="async"
    fetchpriority={fetchPriority}
    data-progressive-image
    pictureAttributes={{
      class: className,
      style: transitionName
        ? `view-transition-name: ${transitionName}`
        : undefined,
      'data-progressive-image': true,
    }}
  />
)}
