---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '@/styles/components/responsive-image.css';

type Props = {
  src: ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  fetchPriority?: 'high' | 'low' | 'auto';
  progressive?: boolean;
  className?: string;
};

const {
  src,
  alt,
  width,
  height,
  sizes = '100vw',
  widths: customWidths,
  loading = 'lazy',
  fetchPriority = 'low',
  progressive = true,
  className,
} = Astro.props;

const defaultWidths = [...new Set([480, 960, 1440, src.width].filter((candidate) => candidate <= src.width))];
const widths = customWidths ?? defaultWidths;
---

<Picture
  src={src}
  widths={widths}
  sizes={sizes}
  formats={['avif']}
  fallbackFormat="webp"
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding="async"
  fetchpriority={fetchPriority}
  class={className}
  data-progressive-image={progressive ? true : undefined}
  pictureAttributes={{ 'data-progressive-image': progressive ? true : undefined }}
/>
