---
import { getImage } from 'astro:assets'
import ResponsivePicture from '@/components/common/ResponsivePicture.vue'
import type { ImageMetadata } from 'astro'
import '@/styles/components/responsive-image.css'

type Props = {
  src: ImageMetadata | string
  alt: string
  width?: number | undefined
  height?: number | undefined
  sizes?: string | undefined
  widths?: number[] | undefined
  quality?: 'low' | 'mid' | 'high' | 'max' | number | undefined
  loading?: 'lazy' | 'eager' | undefined
  fetchPriority?: 'high' | 'low' | 'auto' | undefined
  className?: string | undefined
}

const {
  src,
  alt,
  width,
  height,
  sizes = '100vw',
  widths: customWidths,
  quality,
  loading = 'lazy',
  fetchPriority = 'low',
  className,
} = Astro.props

const isRemoteImage = typeof src === 'string'

if (isRemoteImage && (width === undefined || height === undefined)) {
  throw new Error(
    'ResponsiveImage requires width and height for remote image sources.',
  )
}

const sourceWidth = isRemoteImage ? width : src.width
const sourceHeight = isRemoteImage ? height : src.height
const resolvedWidth = width ?? sourceWidth
const resolvedHeight = height ?? sourceHeight

if (resolvedWidth === undefined || resolvedHeight === undefined) {
  throw new Error('ResponsiveImage could not determine the image dimensions.')
}

const maximumGeneratedWidth = Math.min(sourceWidth ?? 2400, 2400)
const defaultWidths = [
  ...new Set(
    [480, 960, 1440, 1920, 2400, maximumGeneratedWidth].filter(
      (candidate) => candidate <= maximumGeneratedWidth,
    ),
  ),
]
const widths = customWidths ?? defaultWidths
const qualityAttribute = quality === undefined ? {} : { quality }
const optimize = (format: 'avif' | 'webp', candidate: number) =>
  getImage({
    src,
    width: candidate,
    ...(isRemoteImage
      ? { height: Math.round((candidate * resolvedHeight) / resolvedWidth) }
      : {}),
    format,
    ...qualityAttribute,
  })
const [avif, webp, fallback] = await Promise.all([
  Promise.all(widths.map((candidate) => optimize('avif', candidate))),
  Promise.all(widths.map((candidate) => optimize('webp', candidate))),
  optimize('webp', Math.min(resolvedWidth, maximumGeneratedWidth)),
])
const pictureProps = {
  src: fallback.src,
  avifSrcset: avif
    .map((image, index) => `${image.src} ${widths[index]}w`)
    .join(', '),
  webpSrcset: webp
    .map((image, index) => `${image.src} ${widths[index]}w`)
    .join(', '),
  alt,
  width: resolvedWidth,
  height: resolvedHeight,
  sizes,
  loading,
  fetchPriority,
  className,
}
---

{
  alt === '' ? (
    <ResponsivePicture {...pictureProps} progressive={false} />
  ) : loading === 'eager' ? (
    <ResponsivePicture {...pictureProps} progressive={true} client:load />
  ) : (
    <ResponsivePicture
      {...pictureProps}
      progressive={true}
      client:visible={{ rootMargin: '160px' }}
    />
  )
}
