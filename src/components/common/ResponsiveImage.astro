---
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import '@/styles/components/responsive-image.css'

type Props = {
  src: ImageMetadata
  alt: string
  width?: number | undefined
  height?: number | undefined
  sizes?: string | undefined
  widths?: number[] | undefined
  loading?: 'lazy' | 'eager' | undefined
  fetchPriority?: 'high' | 'low' | 'auto' | undefined
  className?: string | undefined
}

const {
  src,
  alt,
  width,
  height,
  sizes = '100vw',
  widths: customWidths,
  loading = 'lazy',
  fetchPriority = 'low',
  className,
} = Astro.props

const defaultWidths = [
  ...new Set(
    [480, 960, 1440, src.width].filter((candidate) => candidate <= src.width),
  ),
]
const widths = customWidths ?? defaultWidths
const isLazy = loading === 'lazy'
const dimensions = {
  ...(width === undefined ? {} : { width }),
  ...(height === undefined ? {} : { height }),
}
---

<Picture
  src={src}
  formats={['avif']}
  fallbackFormat="webp"
  alt={alt}
  {...dimensions}
  widths={widths}
  sizes={sizes}
  loading={loading}
  decoding="async"
  fetchpriority={fetchPriority}
  class={className}
  data-progressive-image
  pictureAttributes={{
    'data-progressive-image': '',
    ...(isLazy ? {} : { 'data-image-requested': 'true' }),
  }}
/>
