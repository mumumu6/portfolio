---
import styles from '@/styles/components/responsive-pair.module.css'

type Props = {
  gap?: string
  stackAt?: 'narrow' | 'wide'
}

const { gap = '1.5rem', stackAt = 'narrow' } = Astro.props
---

<div class={styles.responsivePair} style={`--responsive-pair-gap: ${gap}`}>
  <div class={styles.responsivePairGrid} data-stack-at={stackAt}>
    <slot />
  </div>
</div>
