---
import '@/styles/components/tag-list.css'

type Props = {
  tags?: string[] | undefined
  label?: string | undefined
}

const { tags, label = 'タグ' } = Astro.props
---

{
  tags && tags.length > 0 && (
    <ul class="tag-list" aria-label={label}>
      {tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  )
}
