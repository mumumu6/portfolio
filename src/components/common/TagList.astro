---
import styles from '@/styles/components/tag-list.module.css'

type Props = {
  tags?: string[] | undefined
  label?: string | undefined
}

const { tags, label = 'タグ' } = Astro.props
---

{tags && tags.length > 0 && (
  <ul class={styles.tagList} aria-label={label} data-tag-list>
    {tags.map((tag) => (
      <li>{tag}</li>
    ))}
  </ul>
)}
