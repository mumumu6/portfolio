---
import { entryTransitionName } from '@/lib/entry-transition'
import EntryPreview from '@/components/feed/EntryPreview.astro'
import type { FeedImage } from '@/lib/portfolio/types'

type Props = {
  headingLevel?: 2 | 3
  title?: string | undefined
  body: string
  href?: string | undefined
  image?: FeedImage | undefined
  imageLabel?: string | undefined
  bodyLines?: 2 | 3
  external?: boolean | undefined
  priority?: boolean
  imageSizes?: string
}

const {
  headingLevel = 2,
  title,
  body,
  href,
  image,
  imageLabel,
  bodyLines = 3,
  external = false,
  priority = false,
  // 幅が決まる前は 100vw になる。一覧カードは実寸を渡して、大きい画像の取り直しを避ける。
  imageSizes = 'auto, 100vw',
} = Astro.props
const transitionHref = !external && href?.startsWith('/') ? href : undefined
const Heading = headingLevel === 3 ? 'h3' : 'h2'
---

<div
  class:list={[
    'entry-card-layout',
    { 'entry-card-layout--has-image': Boolean(image) },
  ]}
>
  {title &&
    (href ? (
      <Heading
        class="entry-title"
        aria-label={title}
        style={
          transitionHref
            ? `view-transition-name: ${entryTransitionName(transitionHref, 'title')}`
            : undefined
        }
      >
        <a
          href={href}
          data-astro-prefetch={
            transitionHref &&
            /^\/(?:blog|works)\/[^/]+\/?$/.test(transitionHref)
              ? 'hover'
              : undefined
          }
          aria-label={title}
          target={external ? '_blank' : undefined}
          rel={external ? 'noreferrer' : undefined}
        >
          {title}
        </a>
      </Heading>
    ) : (
      <Heading class="entry-title" aria-label={title}>
        {title}
      </Heading>
    ))}

  {image && (
    <EntryPreview
      image={image}
      href={href}
      label={imageLabel ?? `${title ?? '記事'}を開く`}
      sizes={imageSizes}
      external={external}
      priority={priority}
    />
  )}

  <div class="entry-card-copy">
    <div class="entry-copy-content">
      <p
        class:list={[
          'entry-body',
          { 'entry-body--two-lines': bodyLines === 2 },
        ]}
      >
        {body}
      </p>
      <slot />
    </div>
  </div>
</div>
