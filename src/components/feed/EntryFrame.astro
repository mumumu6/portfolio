---
import styles from '@/styles/components/feed.module.css'
import Avatar from '@/components/common/Avatar.astro'
import type { AuthorId } from '@/repository/shared'

type Props = {
  author: AuthorId
}

const { author } = Astro.props
---

<article class={styles.feedEntry} data-feed-entry data-entry-author={author}>
  <div class={styles.entryGrid}>
    <div class={styles.entryRail} data-entry-rail>
      <Avatar author={author} />
      <span class={styles.entryLine} data-entry-line aria-hidden="true"></span>
    </div>
    <div class={styles.entryContent}>
      <slot />
    </div>
  </div>
</article>
