---
import '@/styles/components/feed.css';
import Avatar from '@/components/common/Avatar.astro';
import type { AuthorId } from '@/lib/portfolio/types';

type Props = {
  author: AuthorId;
  className?: string;
  showAuthorClass?: boolean;
  showLine?: boolean;
};

const { author, className, showAuthorClass = true, showLine = true } = Astro.props;
const classes = [
  'feed-entry',
  className,
  showAuthorClass ? `feed-entry--author-${author}` : undefined,
];
---

<article class:list={classes}>
  <div class="entry-grid">
    <div class="entry-rail">
      <Avatar author={author} />
      {showLine && <span class="entry-line" aria-hidden="true"></span>}
    </div>
    <div class="entry-content">
      <slot />
    </div>
  </div>
</article>
