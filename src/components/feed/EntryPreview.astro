---
import '@/styles/components/entry-preview.css'
import type { FeedImage } from '@/lib/portfolio/types'
import ResponsiveImage from '@/components/common/ResponsiveImage.astro'

type Props = {
  image: FeedImage
  href?: string | undefined
  label: string
  sizes: string
  external?: boolean | undefined
  priority?: boolean | undefined
  className?: string | undefined
}

const {
  image,
  href,
  label,
  sizes,
  external = false,
  priority = false,
  className,
} = Astro.props
const classes = ['ogp-preview', className]
const Wrapper = href ? 'a' : 'div'
const wrapperAttributes = href
  ? {
      href,
      'aria-label': label,
      ...(external ? { target: '_blank', rel: 'noreferrer' } : {}),
    }
  : {}
---

<Wrapper class:list={classes} {...wrapperAttributes}>
  <ResponsiveImage
    src={image.src}
    alt={image.alt}
    widths={[320, 480, 640, 960]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchPriority={priority ? 'high' : 'low'}
  />
</Wrapper>
