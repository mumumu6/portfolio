---
import '@/styles/components/entry-preview.css'
import type { FeedEntry } from '@/lib/portfolio/types'
import ResponsiveImage from '@/components/common/ResponsiveImage.astro'

type Props = {
  image: NonNullable<FeedEntry['image']>
  href?: string | undefined
  label: string
  sizes: string
  external?: boolean | undefined
  priority?: boolean | undefined
  className?: string | undefined
}

const {
  image,
  href,
  label,
  sizes,
  external = false,
  priority = false,
  className,
} = Astro.props
const classes = ['ogp-preview', className]
---

{
  href ? (
    <a
      class:list={classes}
      href={href}
      target={external ? '_blank' : undefined}
      rel={external ? 'noreferrer' : undefined}
      aria-label={label}
    >
      <ResponsiveImage
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
        widths={[320, 480, 640, 960]}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchPriority={priority ? 'high' : 'low'}
      />
    </a>
  ) : (
    <div class:list={classes}>
      <ResponsiveImage
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
        widths={[320, 480, 640, 960]}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchPriority={priority ? 'high' : 'low'}
      />
    </div>
  )
}
