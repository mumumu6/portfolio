---
import styles from '@/styles/components/entry-preview.module.css'
import type { FeedImage } from '@/repository/shared'
import ResponsiveImage from '@/components/common/ResponsiveImage.astro'

type Props = {
  transitionName?: string | undefined
  image: FeedImage
  href?: string | undefined
  label: string
  sizes: string
  external?: boolean | undefined
  priority?: boolean | undefined
}

const {
  image,
  transitionName,
  href,
  label,
  sizes,
  external = false,
  priority = false,
} = Astro.props
const Wrapper = href ? 'a' : 'div'
const wrapperAttributes = href
  ? {
      href,
      'data-astro-prefetch':
        !external && /^\/(?:blog|works)\/[^/]+\/?$/u.test(href)
          ? 'hover'
          : undefined,
      'aria-label': label,
      ...(external ? { target: '_blank', rel: 'noreferrer' } : {}),
    }
  : {}
---

<Wrapper
  class={styles.ogpPreview}
  data-entry-preview
  data-ogp-preview
  style={transitionName ? `view-transition-name: ${transitionName}` : undefined}
  {...wrapperAttributes}
>
  <ResponsiveImage
    fit="cover"
    src={image.src}
    alt={image.alt}
    widths={[320, 480, 640, 960]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchPriority={priority ? 'high' : 'low'}
  />
</Wrapper>
