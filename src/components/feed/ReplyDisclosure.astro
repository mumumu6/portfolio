---
import styles from '@/styles/components/reply.module.css'
import Disclosure from '@/components/common/Disclosure.astro'
import Avatar from '@/components/common/Avatar.astro'
import { mdiChevronDown } from '@mdi/js'
import { authorNames, formatReplyDate } from '@/repository/authors'
import type { Reply } from '@/repository/shared'

type Props = {
  replies: Reply[]
  label?: string
}

const { replies, label = 'AIのコメント' } = Astro.props
---

<Disclosure
  class={
    label !== '返信'
      ? `${styles.replyDisclosure ?? ''} ${styles.replyDisclosureAi ?? ''}`
      : (styles.replyDisclosure ?? '')
  }
  contentClass={styles.replyThreadShell ?? ''}
>
  <span slot="summary" style="display: contents">
    <span>{label}</span>
    <span>{replies.length}</span>
    <span class={styles.replyDisclosureIndicator} aria-hidden="true">
      <svg class={styles.replyDisclosureIcon} viewBox="0 0 24 24">
        <path d={mdiChevronDown}></path>
      </svg>
    </span>
  </span>
  <div class={styles.replyThread}>
    {replies.map((reply) => {
      const dateLabel = formatReplyDate(reply.createdAt)
      return (
        <div class={styles.reply} data-reply>
          <Avatar author={reply.author} size="small" />
          <div class={styles.replyContent}>
            <header class={styles.replyHead} data-reply-head>
              <strong>{authorNames[reply.author]}</strong>
              {dateLabel && (
                <>
                  <span aria-hidden="true">·</span>
                  <time datetime={reply.createdAt}>{dateLabel}</time>
                </>
              )}
            </header>
            <div class={styles.replyBubble}>
              <p>{reply.body}</p>
            </div>
          </div>
        </div>
      )
    })}
  </div>
</Disclosure>
