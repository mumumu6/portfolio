---
import styles from '@/styles/components/work-entry.module.css'
import feedStyles from '@/styles/components/feed.module.css'
import TagList from '@/components/common/TagList.astro'
import EntryBody from '@/components/feed/EntryBody.astro'
import EntryFrame from '@/components/feed/EntryFrame.astro'
import EntryHeader from '@/components/feed/EntryHeader.astro'
import Avatar from '@/components/common/Avatar.astro'
import { statusLabels } from '@/repository/work'
import type { WorkEntry } from '@/repository/work'

type Props = {
  entry: WorkEntry
  headingLevel?: 2 | 3
  priority?: boolean
}

const { entry, headingLevel = 2, priority = false } = Astro.props
---

<EntryFrame author={entry.author}>
  <div class={feedStyles.workEntryLayout}>
    <EntryHeader
      author={entry.author}
      date={entry.date}
      dateLabel={entry.dateLabel}
      status={entry.status}
      statusLabel={statusLabels[entry.status]}
    />

    <EntryBody
      headingLevel={headingLevel}
      title={entry.title}
      body={entry.body}
      href={entry.href}
      image={entry.image}
      imageLabel={`${entry.title}の詳細を見る`}
      priority={priority}
      imageSizes="(max-width: 540px) calc(100vw - 40px), 360px"
    >
      <div class={feedStyles.entryCardMeta}>
        <TagList tags={entry.tags} label="使用技術" />

        <div class={feedStyles.workEntryNotes}>
          <div class={styles.workNotePreview}>
            <Avatar author="mumumu" size="small" />
            <span>
              <strong>
                {entry.comment.label}
                {entry.comment.date &&
                  ` · ${entry.comment.date.replaceAll('-', '.')}`}
              </strong>
              <span>{entry.comment.body}</span>
            </span>
          </div>
        </div>
      </div>
    </EntryBody>
  </div>
</EntryFrame>
