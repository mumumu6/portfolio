---
import '@/styles/components/page-intro.css';
import '@/styles/components/eyebrow.css';

type Props = {
  eyebrow: string;
  title: string;
  description: string;
};

const { eyebrow, title, description } = Astro.props;
---

<header class="page-intro">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p class="page-intro__description">{description}</p>
</header>
