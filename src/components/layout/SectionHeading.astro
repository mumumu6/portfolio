---
import styles from '@/styles/components/section-heading.module.css'
import eyebrowStyles from '@/styles/components/eyebrow.module.css'

type Props = {
  id: string
  eyebrow: string
  title: string
  href: string
}

const { id, eyebrow, title, href } = Astro.props
---

<header class={styles.feedHeading}>
  <div>
    <p class={eyebrowStyles.eyebrow} data-section-eyebrow>
      {eyebrow}
    </p>
    <h2 id={id}>
      <a href={href}>
        {title}
        <span>.</span>
      </a>
    </h2>
  </div>
  <a class={styles.sectionMore} href={href}>
    すべて見る
  </a>
</header>
