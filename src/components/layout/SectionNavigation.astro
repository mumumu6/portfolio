---
import '@/styles/components/site-header-nav.css'
import NavigationLinks from '@/components/layout/NavigationLinks.astro'

type Props = { pathname: string }

const { pathname } = Astro.props
---

<nav
  class="section-nav"
  data-nav-container
  aria-label="メインナビゲーション"
  transition:persist="section-nav"
  transition:animate="none"
>
  <NavigationLinks
    pathname={pathname}
    indicatorClass="section-nav__indicator"
  />
</nav>
