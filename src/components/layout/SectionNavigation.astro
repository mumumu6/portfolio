---
import styles from '@/styles/components/site-header-nav.module.css'
import { matchesNavigationPath, navigationItems } from '@/lib/navigation'

interface Props {
  pathname: string
}

const { pathname } = Astro.props
---

<nav
  class={styles.sectionNav}
  data-nav-container
  data-section-nav
  aria-label="メインナビゲーション"
  transition:persist="section-nav"
>
  {navigationItems.map((item) => {
    const active = matchesNavigationPath(pathname, item.href)
    return (
      <a
        href={item.href}
        class={styles.sectionNavLink}
        aria-current={active ? 'page' : undefined}
        data-nav-link
        data-astro-prefetch
      >
        <span>{item.label}</span>
      </a>
    )
  })}
  <span
    class={styles.sectionNavIndicator}
    data-nav-indicator
    hidden
    aria-hidden="true"
  ></span>
</nav>
