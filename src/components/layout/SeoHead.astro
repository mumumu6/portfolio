---
import favicon from '@/assets/favicon.webp'
import defaultOg from '@/assets/og/default.png'
import type { ImageMetadata } from 'astro'

type Props = {
  title: string
  description: string
  image?: string | ImageMetadata | undefined
  imageAlt?: string | undefined
  type?: 'website' | 'article' | undefined
  publishedTime?: string | undefined
  updatedTime?: string | undefined
  schemaType?:
    | 'WebPage'
    | 'ProfilePage'
    | 'CollectionPage'
    | 'BlogPosting'
    | 'CreativeWork'
    | undefined
  tags?: string[] | undefined
  readingMinutes?: number | undefined
  markdownUrl?: string | undefined
  breadcrumbs?: { name: string; href: string }[] | undefined
}

const {
  title,
  description,
  image = defaultOg,
  imageAlt = 'mumumuのポートフォリオのトップページ',
  type = 'website',
  publishedTime,
  updatedTime,
  schemaType = 'WebPage',
  tags = [],
  readingMinutes,
  markdownUrl,
  breadcrumbs = [],
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)
const imageSrc = typeof image === 'string' ? image : image.src
const socialImage = new URL(imageSrc, Astro.site ?? Astro.url.origin)
const socialImageWidth = typeof image === 'string' ? undefined : image.width
const socialImageHeight = typeof image === 'string' ? undefined : image.height
let socialImageType: string | undefined
if (typeof image === 'string') {
  if (image.endsWith('.png')) socialImageType = 'image/png'
  else if (image.endsWith('.avif')) socialImageType = 'image/avif'
  else if (image.endsWith('.webp')) socialImageType = 'image/webp'
} else {
  socialImageType = `image/${image.format}`
}
const personId = new URL('/#person', Astro.site ?? Astro.url.origin).href
const websiteId = new URL('/#website', Astro.site ?? Astro.url.origin).href
const pageId = `${canonical.href}#webpage`
const breadcrumbData =
  breadcrumbs.length > 0
    ? {
        '@type': 'BreadcrumbList',
        '@id': `${canonical.href}#breadcrumb`,
        itemListElement: breadcrumbs.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.name,
          item: new URL(item.href, Astro.site ?? Astro.url.origin).href,
        })),
      }
    : undefined
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: 'mumumu',
      url: new URL('/', Astro.site ?? Astro.url.origin).href,
      image: new URL(favicon.src, Astro.site ?? Astro.url.origin).href,
      description:
        'Web開発、競技プログラミング、機械学習に取り組む東京科学大学の学生。',
      affiliation: [
        { '@type': 'CollegeOrUniversity', name: '東京科学大学' },
        { '@type': 'Organization', name: 'デジタル創作同好会 traP' },
      ],
      sameAs: [
        'https://github.com/mumumu6',
        'https://twitter.com/mumumu_no_mu66',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: new URL('/', Astro.site ?? Astro.url.origin).href,
      name: 'mumumu portfolio',
      alternateName: ['mumumu', 'mumumu6.net'],
      description:
        'mumumuの制作物、技術記事、活動記録をまとめたポートフォリオ。',
      inLanguage: 'ja',
      author: { '@id': personId },
    },
    {
      '@type': schemaType,
      '@id': pageId,
      url: canonical.href,
      name: title,
      ...(schemaType === 'BlogPosting' || schemaType === 'CreativeWork'
        ? { headline: title }
        : {}),
      description,
      image: socialImage.href,
      inLanguage: 'ja',
      isPartOf: { '@id': websiteId },
      author: { '@id': personId },
      ...(schemaType === 'BlogPosting'
        ? { mainEntityOfPage: canonical.href }
        : {}),
      ...(schemaType === 'ProfilePage'
        ? { mainEntity: { '@id': personId } }
        : {}),
      ...(publishedTime ? { datePublished: publishedTime } : {}),
      ...(updatedTime ? { dateModified: updatedTime } : {}),
      ...(readingMinutes ? { timeRequired: `PT${readingMinutes}M` } : {}),
      ...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
    },
    ...(breadcrumbData ? [breadcrumbData] : []),
  ],
}
const structuredDataJson = JSON.stringify(structuredData).replaceAll(
  '<',
  '\\u003c',
)
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#090d12" data-theme-color />
<meta
  name="robots"
  content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
/>
<link rel="canonical" href={canonical} />
{markdownUrl && (
  <link
    rel="alternate"
    type="text/markdown"
    href={new URL(markdownUrl, Astro.site ?? Astro.url.origin)}
  />
)}
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title="mumumuのブログ"
  href="/rss.xml"
/>
{import.meta.env.PROD && <link rel="manifest" href="/manifest.webmanifest" />}
<meta property="og:site_name" content="mumumu6" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:alt" content={imageAlt} />
{socialImageType && <meta property="og:image:type" content={socialImageType} />}
{socialImageWidth && (
  <meta property="og:image:width" content={String(socialImageWidth)} />
)}
{socialImageHeight && (
  <meta property="og:image:height" content={String(socialImageHeight)} />
)}
{publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{updatedTime && <meta property="article:modified_time" content={updatedTime} />}
{tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={imageAlt} />
<link rel="icon" type="image/webp" href={favicon.src} />
<script is:inline type="application/ld+json" set:html={structuredDataJson} />
