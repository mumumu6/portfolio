---
import '@/styles/components/site-header.css';
import DesktopNavigation from '@/components/layout/DesktopNavigation.astro';
import ProfileHeader from '@/components/profile/ProfileHeader.astro';
import SectionNavigation from '@/components/layout/SectionNavigation.astro';
import ThemeToggle from '@/components/layout/ThemeToggle.astro';

type Props = {
  adaptive?: boolean;
};

const { adaptive = false } = Astro.props;
const pathname = Astro.url.pathname;
const isHome = pathname === '/';
---

<div class:list={['site-chrome', { 'site-chrome--profile': isHome }]}>
  <header class="site-header" transition:persist="site-header" transition:animate="none">
    <div class:list={['header-inner', { 'header-inner--adaptive': adaptive }]}>
      <a class="site-name" href="/" aria-label="mumumu ホーム" data-site-home data-astro-prefetch="false">
        <span>mumumu<em>.</em></span>
      </a>

      <DesktopNavigation pathname={pathname} />
      <ThemeToggle />
    </div>
  </header>

  {isHome && <ProfileHeader adaptive={adaptive} />}

  <SectionNavigation pathname={pathname} adaptive={adaptive} />
</div>

<script>
  import '@/scripts/site-header';
</script>
