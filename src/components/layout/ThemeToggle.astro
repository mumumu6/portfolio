---
import { mdiWeatherNight, mdiWeatherSunny } from '@mdi/js'
import styles from '@/styles/components/theme-toggle.module.css'
---

<button
  class={styles.iconButton}
  type="button"
  data-theme-toggle
  aria-pressed="true"
  aria-label="ライトテーマに切り替える"
  transition:persist="theme-toggle"
>
  <span class={styles.themeIcon} aria-hidden="true">
    <svg class={styles.themeIconSun} viewBox="0 0 24 24">
      <path d={mdiWeatherSunny}></path>
    </svg>
    <svg class={styles.themeIconMoon} viewBox="0 0 24 24">
      <path d={mdiWeatherNight}></path>
    </svg>
  </span>
</button>
