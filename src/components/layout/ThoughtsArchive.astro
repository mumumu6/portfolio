---
import aiStyles from '@/styles/components/ai-disclosure.module.css'
import paginationStyles from '@/styles/components/thoughts-pagination.module.css'
import BaseLayout from '@/layouts/BaseLayout.astro'
import TimelineEntry from '@/components/feed/TimelineEntry.astro'
import TimelineIndex from '@/components/layout/TimelineIndex.astro'
import TimelineSection from '@/components/layout/TimelineSection.astro'
import { groupEntriesByPeriod } from '@/repository/utils'
import timelineStyles from '@/styles/components/timeline.module.css'
import type { TimelineEntry as TimelineEntryData } from '@/repository/experience'

type Props = {
  thoughts: TimelineEntryData[]
  page: number
  totalPages: number
  total: number
}

const { thoughts, page, totalPages, total } = Astro.props
const thoughtGroups = groupEntriesByPeriod(thoughts, (entry) =>
  entry.date.slice(0, 7),
)
const latestLabel = thoughts[0]?.dateLabel ?? '—'
const timelineGroups = thoughtGroups.map(([month, entries]) => ({
  id: `thoughts-${month}`,
  label: month.replace('-', '.'),
  count: entries.length,
}))
const pagePath = (pageNumber: number) =>
  pageNumber === 1 ? '/thoughts/' : `/thoughts/page/${pageNumber}/`
const pageTitle =
  page === 1
    ? 'AI日記 Thoughts | mumumu'
    : `AI日記 Thoughts（${page}ページ目） | mumumu`
---

<BaseLayout
  title={pageTitle}
  description="AIがmumumuの活動ログをもとに書く、AI日記。"
  schemaType="CollectionPage"
>
  <nav class={paginationStyles.pagination} aria-label="Thoughtsのページ">
    <div>
      {Array.from({ length: totalPages }, (_, index) => index + 1).map(
        (pageNumber) => (
          <a
            href={pagePath(pageNumber)}
            aria-current={pageNumber === page ? 'page' : undefined}
            aria-label={`${pageNumber}ページ目`}
          >
            {pageNumber}
          </a>
        ),
      )}
    </div>
  </nav>

  <div class={timelineStyles.experienceLayout}>
    <TimelineIndex
      eyebrow="THOUGHTS INDEX"
      latestLabel={latestLabel}
      groups={timelineGroups}
      total={total}
      navLabel="月別のThoughts"
    />

    <div class={timelineStyles.experienceStream}>
      {thoughtGroups.map(([month, entries]) => (
        <TimelineSection
          id={`thoughts-${month}`}
          headingId={`thoughts-${month}-heading`}
          label={month.replace('-', '.')}
          count={entries.length}
        >
          {entries.map((entry) => (
            <TimelineEntry entry={entry} headingLevel={3} />
          ))}
        </TimelineSection>
      ))}
    </div>
  </div>

  <nav class={paginationStyles.pagination} aria-label="Thoughtsのページ">
    <div>
      {Array.from({ length: totalPages }, (_, index) => index + 1).map(
        (pageNumber) => (
          <a
            href={pagePath(pageNumber)}
            aria-current={pageNumber === page ? 'page' : undefined}
            aria-label={`${pageNumber}ページ目`}
          >
            {pageNumber}
          </a>
        ),
      )}
    </div>
  </nav>

  <aside class={aiStyles.aiDisclosure} aria-label="AI生成について">
    <strong>このページについて</strong>
    <p>
      投稿と返信はChatGPT・CodexのログをもとにAIで生成し、公開前に本人が確認しています。
    </p>
  </aside>
</BaseLayout>
