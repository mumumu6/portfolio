---
import '@/styles/components/timeline.css';
import '@/styles/components/eyebrow.css';

type TimelineGroup = {
  id: string;
  label: string;
  count: number;
};

type Props = {
  eyebrow: string;
  latestLabel: string;
  groups: TimelineGroup[];
  total: number;
  navLabel: string;
  totalLabel?: string;
};

const { eyebrow, latestLabel, groups, total, navLabel, totalLabel = '件' } = Astro.props;
---

<aside class="experience-index">
  <p class="eyebrow">{eyebrow}</p>
  <p class="experience-index__latest"><span>LATEST</span><strong>{latestLabel}</strong></p>
  <nav aria-label={navLabel}>
    {
      groups.map((group) => (
        <a href={`#${group.id}`}>
          <span>{group.label}</span>
          <i aria-hidden="true" />
          <strong>{String(group.count).padStart(2, '0')}</strong>
        </a>
      ))
    }
  </nav>
  <p class="experience-index__total">全{total}{totalLabel}</p>
</aside>
