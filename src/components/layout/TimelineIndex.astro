---
import styles from '@/styles/components/timeline.module.css'
import eyebrowStyles from '@/styles/components/eyebrow.module.css'

type TimelineGroup = {
  id: string
  label: string
  count: number
}

type Props = {
  eyebrow: string
  latestLabel: string
  groups: TimelineGroup[]
  total: number
  navLabel: string
}

const { eyebrow, latestLabel, groups, total, navLabel } = Astro.props
---

<aside class={styles.experienceIndex}>
  <p class={eyebrowStyles.eyebrow}>{eyebrow}</p>
  <p class={styles.experienceIndexLatest}>
    <span>LATEST</span>
    <strong>{latestLabel}</strong>
  </p>
  <nav aria-label={navLabel}>
    {groups.map((group) => (
      <a href={`#${group.id}`}>
        <span>{group.label}</span>
        <i aria-hidden="true" />
        <strong>{String(group.count).padStart(2, '0')}</strong>
      </a>
    ))}
  </nav>
  <p class={styles.experienceIndexTotal}>全{total}件</p>
</aside>
