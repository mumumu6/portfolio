---
import styles from '@/styles/components/timeline.module.css'

type Props = {
  id: string
  headingId: string
  label: string
  count: number
}

const { id, headingId, label, count } = Astro.props
---

<section
  class={styles.timelineGroup}
  data-timeline-group
  id={id}
  aria-labelledby={headingId}
>
  <h2 class={styles.timelineGroupHeading} id={headingId}>
    <span>{label}</span>
    <small>{count}件</small>
  </h2>
  <div data-feed-list="timeline">
    <slot />
  </div>
</section>
