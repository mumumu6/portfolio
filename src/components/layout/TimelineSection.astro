---
import '@/styles/components/timeline.css'

type Props = {
  id: string
  headingId: string
  label: string
  count: number
}

const { id, headingId, label, count } = Astro.props
---

<section class="timeline-group" id={id} aria-labelledby={headingId}>
  <h2 class="timeline-group__heading" id={headingId}>
    <span>{label}</span><small>{count}件</small>
  </h2>
  <div class="feed-list feed-list--timeline">
    <slot />
  </div>
</section>
