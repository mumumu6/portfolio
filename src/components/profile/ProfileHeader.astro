---
import '@/styles/components/profile.css'
import Avatar from '@/components/common/Avatar.astro'
import { getEntry } from 'astro:content'

type Props = {
  adaptive?: boolean
}

const { adaptive = false } = Astro.props
const profileEntry = await getEntry('site', 'profile')
if (!profileEntry) throw new Error('Missing site profile content')
const { data: profile } = profileEntry
---

<section
  class:list={['profile-header', { 'profile-header--adaptive': adaptive }]}
  aria-labelledby="profile-name"
>
  <div class="profile-cover" aria-hidden="true"></div>
  <div class="profile-main">
    <div class="profile-top">
      <a class="profile-portrait" href="/" aria-label="mumumu ホーム">
        <Avatar author="mumumu" size="large" />
      </a>

      <nav class="profile-links" aria-label="外部プロフィール">
        {
          profile.links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noreferrer"
              aria-label={`${link.label}プロフィール`}
            >
              <span
                class:list={[
                  'profile-link-icon',
                  `profile-link-icon--${link.icon}`,
                ]}
                aria-hidden="true"
              >
                {link.icon === 'github' && (
                  <svg viewBox="0 0 24 24">
                    <path d="M10.226 17.284c-2.965-.36-5.054-2.493-5.054-5.256 0-1.123.404-2.336 1.078-3.144-.292-.741-.247-2.314.09-2.965.898-.112 2.111.36 2.83 1.01.853-.269 1.752-.404 2.853-.404 1.1 0 1.999.135 2.807.382.696-.629 1.932-1.1 2.83-.988.315.606.36 2.179.067 2.942.72.854 1.101 2 1.101 3.167 0 2.763-2.089 4.852-5.098 5.234.763.494 1.28 1.572 1.28 2.807v2.336c0 .674.561 1.056 1.235.786 4.066-1.55 7.255-5.615 7.255-10.646C23.5 6.188 18.334 1 11.978 1 5.62 1 .5 6.188.5 12.545c0 4.986 3.167 9.12 7.435 10.669.606.225 1.19-.18 1.19-.786V20.63a2.9 2.9 0 0 1-1.078.224c-1.483 0-2.359-.808-2.987-2.313-.247-.607-.517-.966-1.034-1.033-.27-.023-.359-.135-.359-.27 0-.27.45-.471.898-.471.652 0 1.213.404 1.797 1.235.45.651.921.943 1.483.943.561 0 .92-.202 1.437-.719.382-.381.674-.718.944-.943" />
                  </svg>
                )}
                {link.icon === 'x' && (
                  <svg viewBox="0 0 1200 1227">
                    <path d="M714.163 519.284 1160.89 0h-105.86L667.137 450.887 357.328 0H0l468.492 681.821L0 1226.37h105.866l409.625-476.152 327.181 476.152H1200L714.137 519.284h.026ZM569.165 687.828l-47.468-67.894L144.011 79.694h162.604l304.797 435.991 47.468 67.894 396.2 566.721H892.476L569.165 687.854v-.026Z" />
                  </svg>
                )}
              </span>
            </a>
          ))
        }
      </nav>
    </div>

    <div class="profile-copy">
      <h1 id="profile-name">{profile.name}<span>.</span></h1>
      <p class="profile-bio">{profile.bio}</p>
    </div>
    <ul class="profile-meta" aria-label="プロフィール情報">
      {profile.affiliations.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>
