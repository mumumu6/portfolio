---
import '@/styles/components/feed.css'
import Avatar from '@/components/common/Avatar.astro'
import type { AuthorId } from '@/lib/portfolio/types'

type Props = {
  author: AuthorId
  className?: string
}

const { author, className } = Astro.props
const authorClass =
  author === 'mumumu' ? undefined : `feed-entry--author-${author}`
const classes = ['feed-entry', className, authorClass]
---

<article class:list={classes}>
  <div class="entry-grid">
    <div class="entry-rail">
      <Avatar author={author} />
      <span class="entry-line" aria-hidden="true"></span>
    </div>
    <div class="entry-content">
      <slot />
    </div>
  </div>
</article>
