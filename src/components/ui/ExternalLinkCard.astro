---
import '@/styles/components/external-link-card.css'

type Props = {
  href: string
  label: string
}

const { href, label } = Astro.props
const hostLabel = new URL(href).hostname
---

<a class="external-card-link" href={href} target="_blank" rel="noreferrer">
  <span>
    <strong>{label}</strong>
    <small>{hostLabel}</small>
  </span>
</a>
