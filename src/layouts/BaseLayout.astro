---
import '@/styles/global.css'
import { ClientRouter } from 'astro:transitions'
import SeoHead from '@/components/layout/SeoHead.astro'
import SiteHeader from '@/components/layout/SiteHeader.astro'
import ibmPlexSansJp400 from '@fontsource/ibm-plex-sans-jp/files/ibm-plex-sans-jp-latin-400-normal.woff2?url'
import spaceGrotesk500 from '@fontsource/space-grotesk/files/space-grotesk-latin-500-normal.woff2?url'
import spaceGrotesk600 from '@fontsource/space-grotesk/files/space-grotesk-latin-600-normal.woff2?url'
import spaceGrotesk700 from '@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url'

type Props = {
  title: string
  description: string
  image?: string | undefined
  imageAlt?: string | undefined
  imageWidth?: number | undefined
  imageHeight?: number | undefined
  type?: 'website' | 'article' | undefined
  publishedTime?: string | undefined
  updatedTime?: string | undefined
  schemaType?:
    | 'WebPage'
    | 'ProfilePage'
    | 'CollectionPage'
    | 'BlogPosting'
    | 'CreativeWork'
    | undefined
  tags?: string[] | undefined
  readingMinutes?: number | undefined
  shell?: 'default' | 'wide' | 'adaptive' | undefined
}

const { shell = 'default', ...seoProps } = Astro.props
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={ibmPlexSansJp400}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={spaceGrotesk500}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={spaceGrotesk600}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={spaceGrotesk700}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <SeoHead {...seoProps} />
    <ClientRouter />
    <title>{seoProps.title}</title>
    <script is:inline>
      ;(() => {
        document.documentElement.classList.add('js')
        let saved = null
        try {
          saved = localStorage.getItem('theme')
        } catch {
          // Storage can be unavailable in privacy-restricted contexts.
        }
        const theme = saved || 'dark'
        document.documentElement.dataset.theme = theme
        document.documentElement.style.colorScheme = theme
        document
          .querySelector('[data-theme-color]')
          ?.setAttribute('content', theme === 'dark' ? '#090d12' : '#eef1f4')
      })()
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <SiteHeader adaptive={shell === 'adaptive'} />
    <main
      class:list={[
        'site-shell',
        {
          'site-shell--wide': shell === 'wide',
          'site-shell--adaptive': shell === 'adaptive',
        },
      ]}
      id="main-content"
    >
      <slot />
    </main>

    <script>
      import '@/scripts/site-ui'
    </script>
  </body>
</html>
