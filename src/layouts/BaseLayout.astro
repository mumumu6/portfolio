---
import '@/styles/global.css'
import { ClientRouter } from 'astro:transitions'
import SeoHead from '@/components/layout/SeoHead.astro'
import SiteHeader from '@/components/layout/SiteHeader.astro'

type Props = {
  title: string
  description: string
  image?: string
  imageAlt?: string
  imageWidth?: number
  imageHeight?: number
  type?: 'website' | 'article'
  publishedTime?: string
  updatedTime?: string
  schemaType?:
    | 'WebPage'
    | 'ProfilePage'
    | 'CollectionPage'
    | 'BlogPosting'
    | 'CreativeWork'
  tags?: string[]
  readingMinutes?: number
  shell?: 'default' | 'wide' | 'adaptive'
}

const { shell = 'default', ...seoProps } = Astro.props
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" initial-scale="1.0/" />
    <SeoHead {...seoProps} />
    <ClientRouter />
    <title>{seoProps.title}</title>
    <script is:inline>
      ;(() => {
        document.documentElement.classList.add('js')
        let saved = null
        try {
          saved = localStorage.getItem('theme')
        } catch {
          // Storage can be unavailable in privacy-restricted contexts.
        }
        const theme = saved || 'dark'
        document.documentElement.dataset.theme = theme
        document.documentElement.style.colorScheme = theme
        document
          .querySelector('[data-theme-color]')
          ?.setAttribute('content', theme === 'dark' ? '#090d12' : '#eef1f4')
      })()
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <SiteHeader adaptive={shell === 'adaptive'} />
    <main
      class:list={[
        'site-shell',
        {
          'site-shell--wide': shell === 'wide',
          'site-shell--adaptive': shell === 'adaptive',
        },
      ]}
      id="main-content"
    >
      <slot />
    </main>

    <script>
      import '@/scripts/site-ui'
    </script>
  </body>
</html>
