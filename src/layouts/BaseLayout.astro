---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SeoHead from '@/components/layout/SeoHead.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';

type Props = {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article';
  publishedTime?: string;
  updatedTime?: string;
  schemaType?: 'WebPage' | 'ProfilePage' | 'CollectionPage' | 'BlogPosting' | 'CreativeWork';
  tags?: string[];
  readingMinutes?: number;
  shell?: 'default' | 'wide' | 'adaptive';
};

const { shell = 'default', ...seoProps } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead {...seoProps} />
    <script is:inline>
      (() => {
        history.scrollRestoration = 'manual';
        const restoreScrollPosition = () => {
          const state = history.state;
          const scrollX = Number(state?.scrollX);
          const scrollY = Number(state?.scrollY);
          if (!Number.isFinite(scrollX) || !Number.isFinite(scrollY) || (scrollX === 0 && scrollY === 0)) return;
          window.scrollTo({ left: scrollX, top: scrollY, behavior: 'instant' });
        };

        // Client-side navigations are coordinated by site-header.ts. Keeping
        // this initial-load restore here avoids a visible jump after reload
        // without competing with the transition scroll handler.
        window.addEventListener('load', restoreScrollPosition, { once: true });
      })();
    </script>
    <ClientRouter />
    <title>{seoProps.title}</title>
    <style is:inline>
      html,
      body {
        background-color: #090d12;
        color: #edf2f6;
        color-scheme: dark;
      }

      html[data-theme='light'],
      html[data-theme='light'] body {
        background-color: #eef1f4;
        color: #111820;
        color-scheme: light;
      }
    </style>
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {
          // Storage can be unavailable in privacy-restricted contexts.
        }
        const theme = saved || 'dark';
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        document.querySelector('[data-theme-color]')?.setAttribute('content', theme === 'dark' ? '#090d12' : '#eef1f4');

        const connection = navigator.connection;
        if (connection?.saveData || /(^|-)2g$/.test(connection?.effectiveType ?? '')) {
          document.documentElement.dataset.network = 'slow';
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <SiteHeader adaptive={shell === 'adaptive'} />
    <main
      class:list={[
        'site-shell',
        { 'site-shell--wide': shell === 'wide', 'site-shell--adaptive': shell === 'adaptive' },
      ]}
      id="main-content"
    >
      <slot />
    </main>

    <script>
      import '@/scripts/site-ui';
    </script>
  </body>
</html>
