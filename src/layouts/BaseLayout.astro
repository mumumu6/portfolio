---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';

type Props = {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  shell?: 'default' | 'wide';
};

const {
  title,
  description,
  image = '/favicon.webp',
  type = 'website',
  publishedTime,
  shell = 'default',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImage = new URL(image, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="mumumu6.net" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const theme = saved || 'dark';
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <SiteHeader wide={shell === 'wide'} />
    <main class:list={['site-shell', { 'site-shell--wide': shell === 'wide' }]} id="main-content">
      <slot />
    </main>

    <script>
      const applyTheme = (theme: 'light' | 'dark') => {
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        localStorage.setItem('theme', theme);
      };

      const closeMenu = () => {
        const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
        const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
        const header = document.querySelector<HTMLElement>('.site-header');
        if (!menuButton || !menu) return;
        menu.hidden = true;
        menuButton.setAttribute('aria-expanded', 'false');
        menuButton.setAttribute('aria-label', 'メニューを開く');
        header?.removeAttribute('data-hidden');
      };

      const setupHeaderScroll = () => {
        const header = document.querySelector<HTMLElement>('.site-header');
        if (!header || header.dataset.scrollBound === 'true') return;

        header.dataset.scrollBound = 'true';
        let previousY = window.scrollY;
        let frame = 0;

        window.addEventListener('scroll', () => {
          if (frame) return;
          frame = requestAnimationFrame(() => {
            frame = 0;
            const currentY = window.scrollY;
            const delta = currentY - previousY;
            const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

            if (currentY <= 24 || delta < -4 || menu?.hidden === false) {
              header.removeAttribute('data-hidden');
            } else if (currentY > 96 && delta > 4) {
              header.dataset.hidden = 'true';
            }

            if (Math.abs(delta) > 4) previousY = currentY;
          });
        }, { passive: true });
      };

      const setupUi = () => {
        document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
          if (button.dataset.bound === 'true') return;
          button.dataset.bound = 'true';
          button.addEventListener('click', () => {
            applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
          });
        });

        document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((link) => {
          const href = link.getAttribute('href') ?? '';
          const active = href !== '/' && (location.pathname === href || location.pathname.startsWith(`${href}/`));
          link.classList.toggle('active', active);
          if (active) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        });

        setupHeaderScroll();

        const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
        const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
        if (!menuButton || !menu || menuButton.dataset.bound === 'true') return;

        menuButton.dataset.bound = 'true';
        menuButton.addEventListener('click', () => {
          const willOpen = menu.hidden;
          document.querySelector<HTMLElement>('.site-header')?.removeAttribute('data-hidden');
          menu.hidden = !willOpen;
          menuButton.setAttribute('aria-expanded', String(willOpen));
          menuButton.setAttribute('aria-label', willOpen ? 'メニューを閉じる' : 'メニューを開く');
        });
      };

      document.addEventListener('astro:before-swap', (event) => {
        const theme = localStorage.getItem('theme') || 'dark';
        event.newDocument.documentElement.dataset.theme = theme;
        event.newDocument.documentElement.style.colorScheme = theme;
      });

      document.addEventListener('astro:page-load', () => {
        closeMenu();
        setupUi();
      });
      setupUi();

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMenu();
      });
    </script>
  </body>
</html>
