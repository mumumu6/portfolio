---
import BaseLayout from '@/layouts/BaseLayout.astro'
import styles from '@/styles/components/not-found.module.css'
---

<BaseLayout
  title="ページが見つかりません | mumumu"
  description="お探しのページは見つかりませんでした。"
  noindex
>
  <section class={styles.notFound} aria-labelledby="not-found-title">
    <p class={styles.eyebrow}>
      <span class={styles.statusMark} aria-hidden="true"></span>
      PAGE / ERROR
    </p>
    <p class={styles.code}>404</p>
    <h1 id="not-found-title">ページが見つかりません</h1>
    <p class={styles.message}>
      URLが変わったか、ページが公開されていないようです。
    </p>
  </section>
</BaseLayout>
