---
import BaseLayout from '@/components/shell/BaseLayout.astro'
import BlogCard from '@/features/blog/BlogCard.astro'
import { blogPosts } from '@/lib/content/blogs'
---

<BaseLayout
  title="技術ブログ・制作記録 | mumumu"
  description="mumumuが書いた技術記事と制作記録。"
  schemaType="CollectionPage"
>
  <div class="feed-list feed-list--compact">
    {blogPosts.map((entry, index) => (
      <BlogCard entry={entry} priority={index === 0} />
    ))}
  </div>
</BaseLayout>
