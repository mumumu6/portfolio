---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import FeedEntry from '../components/FeedEntry.astro';
import { blogPosts } from '../data/content';
---

<BaseLayout
  title="技術ブログ・制作記録 | mumumu"
  description="mumumuが書いた技術記事と制作記録。"
  schemaType="CollectionPage"
>
  <PageIntro
    eyebrow="WRITTEN THINGS"
    title="Blog"
    description="技術の話、作ったものの記録、途中で見つけた面白いこと。"
  />
  <div class="feed-list feed-list--compact">
    {blogPosts.map((entry) => <FeedEntry entry={entry} />)}
  </div>
</BaseLayout>
