---
import BaseLayout from '@/layouts/BaseLayout.astro'
import BlogCard from '@/components/feed/BlogCard.astro'
import { blogPosts } from '@/lib/portfolio/blogs'
---

<BaseLayout
  title="技術ブログ・制作記録 | mumumu"
  description="mumumuが書いた技術記事と制作記録。"
  schemaType="CollectionPage"
  shell="adaptive"
>
  <div class="feed-list feed-list--compact">
    {
      blogPosts.map((entry, index) => (
        <BlogCard entry={entry} priority={index === 0} />
      ))
    }
  </div>
</BaseLayout>
