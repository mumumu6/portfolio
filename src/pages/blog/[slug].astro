---
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import '@/styles/pages/blog.css'
import '@/styles/components/article-prose.css'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ArticleToc from '@/components/article/ArticleToc.astro'
import ResponsiveImage from '@/components/common/ResponsiveImage.astro'
import TagList from '@/components/common/TagList.astro'
import { estimateReadingMinutes } from '@/lib/portfolio/utils'

type Props = { post: CollectionEntry<'blogs'> }

export async function getStaticPaths() {
  const localPosts = await getCollection('blogs')
  return localPosts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const props: Props = Astro.props
const post = props.post
const { Content, headings } = await render(post)
const data = post.data
const readingMinutes = estimateReadingMinutes(post.body ?? data.description)
const publishedAt = data.publishedAt.toISOString().slice(0, 10)
const updatedAt = data.updatedAt?.toISOString().slice(0, 10)
const dateLabel = publishedAt.replaceAll('-', '.')
const tocHeadings = headings.filter((heading) => heading.depth <= 3)
---

<BaseLayout
  title={`${data.title} — mumumu`}
  description={data.description}
  image={data.cover}
  imageAlt={data.coverAlt}
  type="article"
  showProfileHeader={false}
  publishedTime={publishedAt}
  updatedTime={updatedAt}
  schemaType="BlogPosting"
  tags={data.tags}
  readingMinutes={readingMinutes}
  breadcrumbs={[
    { name: 'ホーム', href: '/' },
    { name: 'ブログ', href: '/blog/' },
    { name: data.title, href: Astro.url.pathname },
  ]}
>
  <article class="article-page">
    <div class="reading-progress" data-reading-progress aria-hidden="true">
      <svg class="reading-progress__ring" viewBox="0 0 48 48">
        <circle class="reading-progress__track" cx="24" cy="24" r="21.5"
        ></circle>
        <circle
          class="reading-progress__value"
          cx="24"
          cy="24"
          r="21.5"
          pathLength="100"
          data-reading-progress-ring></circle>
      </svg>
      <span data-reading-progress-label>0%</span>
    </div>
    <div class="article-hero">
      <ResponsiveImage
        className="article-cover"
        src={data.cover}
        sizes="(max-width: 760px) calc(100vw - 32px), 780px"
        alt={data.coverAlt}
        loading="eager"
        fetchPriority="high"
      />
      <header class="article-header">
        <h1>{data.title}</h1>
        <div class="article-meta">
          <time datetime={publishedAt}>{dateLabel}</time>
          <span>約{readingMinutes}分</span>
        </div>
      </header>
    </div>
    <div class="article-intro">
      <p class="article-lead">{data.description}</p>
      <div class="article-tags"><TagList tags={data.tags} /></div>
    </div>

    <ArticleToc headings={tocHeadings} mode="mobile" />

    <div class="article-layout">
      <ArticleToc headings={tocHeadings} mode="desktop" />
      <div class="article-prose"><Content /></div>
    </div>
  </article>
</BaseLayout>
