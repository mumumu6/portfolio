---
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import '@/styles/pages/blog.css'
import '@/styles/components/article-prose.css'
import '@/styles/components/article-nav.css'
import '@/styles/components/eyebrow.css'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ArticleToc from '@/components/article/ArticleToc.astro'
import ReplyDisclosure from '@/components/feed/ReplyDisclosure.astro'
import ResponsiveImage from '@/components/common/ResponsiveImage.astro'
import TagList from '@/components/common/TagList.astro'
import { getAiReplies } from '@/lib/portfolio/ai'
import { estimateReadingMinutes } from '@/lib/portfolio/utils'

type Props = { post: CollectionEntry<'blogs'> }

export async function getStaticPaths() {
  const localPosts = await getCollection('blogs')
  return localPosts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const props: Props = Astro.props
const post = props.post
const { Content, headings } = await render(post)
const data = post.data
const aiReplies = getAiReplies('blog', post.id) ?? []
const readingMinutes = estimateReadingMinutes(post.body ?? data.description)
const publishedAt = data.publishedAt.toISOString().slice(0, 10)
const updatedAt = data.updatedAt?.toISOString().slice(0, 10)
const dateLabel = publishedAt.replaceAll('-', '.')
const tocHeadings = headings.filter((heading) => heading.depth <= 3)
---

<BaseLayout
  title={`${data.title} — mumumu`}
  description={data.description}
  image={data.cover}
  imageAlt={data.coverAlt}
  type="article"
  shell="adaptive"
  showProfileHeader={false}
  publishedTime={publishedAt}
  updatedTime={updatedAt}
  schemaType="BlogPosting"
  tags={data.tags}
  readingMinutes={readingMinutes}
  breadcrumbs={[
    { name: 'ホーム', href: '/' },
    { name: 'ブログ', href: '/blog/' },
    { name: data.title, href: Astro.url.pathname },
  ]}
>
  <article class="article-page">
    <div class="reading-progress" data-reading-progress aria-hidden="true">
      <span data-reading-progress-label>0%</span>
    </div>
    <div class="article-hero">
      <ResponsiveImage
        className="article-cover"
        src={data.cover}
        sizes="(max-width: 760px) calc(100vw - 32px), 780px"
        alt={data.coverAlt}
        loading="eager"
        fetchPriority="high"
      />
      <header class="article-header">
        <h1>{data.title}</h1>
        <div class="article-meta">
          <time datetime={publishedAt}>{dateLabel}</time>
          <span>約{readingMinutes}分</span>
        </div>
      </header>
    </div>
    <div class="article-intro">
      <p class="article-lead">{data.description}</p>
      <div class="article-tags"><TagList tags={data.tags} /></div>
    </div>

    <ArticleToc headings={tocHeadings} mode="mobile" />

    <div class="article-layout">
      <ArticleToc headings={tocHeadings} mode="desktop" />
      <div class="article-prose"><Content /></div>
    </div>

    {
      aiReplies.length > 0 && (
        <section
          class="article-comments"
          aria-labelledby="article-comments-title"
        >
          <div class="article-comments__head">
            <p class="eyebrow">MARGIN NOTES</p>
            <h2 id="article-comments-title">AIのコメント</h2>
          </div>
          <ReplyDisclosure replies={aiReplies} label="コメント" open />
        </section>
      )
    }
  </article>
</BaseLayout>

<script>
  let progressFrame = 0
  let measurementFrame = 0
  let progressStart = 0
  let progressEnd = 1
  let previousProgressPercent = -1
  let previousHeadingId: string | null | undefined
  let progressRing: HTMLElement | null = null
  let progressLabels: HTMLElement[] = []
  let progressHeadings: { id: string; top: number }[] = []
  let progressLinks: HTMLAnchorElement[] = []

  const measureReadingProgress = () => {
    measurementFrame = 0
    const article = document.querySelector<HTMLElement>('.article-page')
    progressRing = document.querySelector<HTMLElement>(
      '[data-reading-progress]',
    )
    progressLabels = [
      ...document.querySelectorAll<HTMLElement>(
        '[data-reading-progress-label]',
      ),
    ]
    progressLinks = [
      ...document.querySelectorAll<HTMLAnchorElement>('.article-toc a'),
    ]

    if (!article || !progressRing) {
      progressHeadings = []
      return
    }

    const articleRect = article.getBoundingClientRect()
    progressStart = articleRect.top + window.scrollY
    progressEnd = Math.max(
      progressStart + articleRect.height - window.innerHeight,
      progressStart + 1,
    )
    progressHeadings = [
      ...article.querySelectorAll<HTMLElement>(
        '.article-prose h2, .article-prose h3',
      ),
    ].map((heading) => ({
      id: heading.id,
      top: heading.getBoundingClientRect().top + window.scrollY,
    }))
    previousProgressPercent = -1
    previousHeadingId = undefined
    scheduleReadingProgress()
  }

  const scheduleReadingProgressMeasurement = () => {
    if (measurementFrame) return
    measurementFrame = requestAnimationFrame(measureReadingProgress)
  }

  const updateReadingProgress = () => {
    progressFrame = 0
    if (!progressRing) return

    const scrollY = window.scrollY
    const progress = Math.min(
      1,
      Math.max(0, (scrollY - progressStart) / (progressEnd - progressStart)),
    )
    const progressPercent = Math.round(progress * 100)
    let currentHeadingId: string | null = null
    for (let index = progressHeadings.length - 1; index >= 0; index -= 1) {
      const heading = progressHeadings[index]
      if (heading && heading.top <= scrollY + 150) {
        currentHeadingId = heading.id
        break
      }
    }

    if (progressPercent !== previousProgressPercent) {
      previousProgressPercent = progressPercent
      progressRing.style.setProperty(
        '--reading-progress',
        `${progressPercent * 3.6}deg`,
      )
      progressLabels.forEach((label) => {
        label.textContent = `${progressPercent}%`
      })
    }

    if (currentHeadingId !== previousHeadingId) {
      previousHeadingId = currentHeadingId
      progressLinks.forEach((link) => {
        const active = currentHeadingId
          ? link.hash === `#${encodeURIComponent(currentHeadingId)}`
          : false
        link.classList.toggle('active', active)
        if (active) link.setAttribute('aria-current', 'location')
        else link.removeAttribute('aria-current')
      })
    }
  }

  const scheduleReadingProgress = () => {
    if (progressFrame) return
    progressFrame = requestAnimationFrame(updateReadingProgress)
  }

  window.addEventListener('scroll', scheduleReadingProgress, { passive: true })
  window.addEventListener('resize', scheduleReadingProgressMeasurement)
  document.addEventListener(
    'astro:page-load',
    scheduleReadingProgressMeasurement,
  )

  const handleTocClick = (event: MouseEvent) => {
    if (
      event.defaultPrevented ||
      event.button !== 0 ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey
    ) {
      return
    }

    const clicked = event.target
    if (!(clicked instanceof Element)) return
    const link = clicked.closest<HTMLAnchorElement>(
      '.article-toc a, .article-toc-mobile a',
    )
    if (
      !link ||
      !link.hash ||
      link.origin !== location.origin ||
      link.pathname !== location.pathname
    ) {
      return
    }

    const heading = document.getElementById(
      decodeURIComponent(link.hash.slice(1)),
    )
    if (!heading) return

    event.preventDefault()
    history.pushState({ ...history.state }, '', `${link.pathname}${link.hash}`)
    const navigation = document.querySelector<HTMLElement>('.section-nav')
    const navigationOffset =
      (navigation?.getBoundingClientRect().height ?? 0) + 16
    const targetTop =
      heading.getBoundingClientRect().top + window.scrollY - navigationOffset

    window.scrollTo({
      top: Math.max(0, targetTop),
      behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ? 'auto'
        : 'smooth',
    })
    link.closest('details')?.removeAttribute('open')
  }

  document.addEventListener('click', handleTocClick, { capture: true })
  document.fonts.ready.then(scheduleReadingProgressMeasurement)
  scheduleReadingProgressMeasurement()
</script>
