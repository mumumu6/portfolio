---
import { entryTransitionName } from '@/lib/entry-transition'
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import '@/styles/pages/blog.css'
import '@/styles/components/article-prose.css'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ArticleControls from '@/components/article/ArticleControls.astro'
import ResponsiveImage from '@/components/common/ResponsiveImage.astro'
import TagList from '@/components/common/TagList.astro'
import { estimateReadingMinutes } from '@/lib/portfolio/utils'

type Props = { post: CollectionEntry<'blogs'> }

export const getStaticPaths = async () => {
  const localPosts = await getCollection('blogs')
  return localPosts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const props: Props = Astro.props
const post = props.post
const { Content, headings } = await render(post)
const transitionHref = `/blog/${post.id}/`
const data = post.data
const readingMinutes = estimateReadingMinutes(post.body ?? data.description)
const publishedAt = data.publishedAt.toISOString().slice(0, 10)
const updatedAt = data.updatedAt?.toISOString().slice(0, 10)
const dateLabel = publishedAt.replaceAll('-', '.')
const tocHeadings = headings.filter((heading) => heading.depth <= 3)
---

<BaseLayout
  title={`${data.title} — mumumu`}
  description={data.description}
  image={data.cover}
  imageAlt={data.coverAlt}
  type="article"
  publishedTime={publishedAt}
  updatedTime={updatedAt}
  schemaType="BlogPosting"
  tags={data.tags}
  readingMinutes={readingMinutes}
  breadcrumbs={[
    { name: 'ホーム', href: '/' },
    { name: 'ブログ', href: '/blog/' },
    { name: data.title, href: Astro.url.pathname },
  ]}
>
  <article id="article-page" class="article-page">
    <div class="article-hero">
      <ResponsiveImage
        className="article-cover"
        src={data.cover}
        widths={[480, 960, 1440]}
        sizes="(max-width: 760px) calc(100vw - 32px), (max-width: 862px) calc(100vw - 42px), (max-width: 1232px) 778px, min(calc(100vw - 454px), 1398px)"
        alt={data.coverAlt}
        quality={30}
        loading="eager"
        fetchPriority="high"
      />
      <header class="article-header">
        <h1
          style={`view-transition-name: ${entryTransitionName(transitionHref, 'title')}`}
        >
          {data.title}
        </h1>
        <div class="article-meta">
          <time datetime={publishedAt}>{dateLabel}</time>
          <span>約{readingMinutes}分</span>
        </div>
      </header>
    </div>
    <div class="article-intro">
      <p class="article-lead">{data.description}</p>
      <div class="article-tags">
        <TagList tags={data.tags} />
      </div>
    </div>
    <ArticleControls articleId="article-page" headings={tocHeadings}>
      <Content />
    </ArticleControls>
  </article>
</BaseLayout>
