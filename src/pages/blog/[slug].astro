---
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import '@/styles/pages/blog.css'
import '@/styles/components/article-prose.css'
import '@/styles/components/article-nav.css'
import '@/styles/components/eyebrow.css'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ArticleToc from '@/components/article/ArticleToc.astro'
import ReplyDisclosure from '@/components/feed/ReplyDisclosure.astro'
import ResponsiveImage from '@/components/common/ResponsiveImage.astro'
import TagList from '@/components/common/TagList.astro'
import { getAiReplies } from '@/lib/portfolio/ai'
import { estimateReadingMinutes } from '@/lib/portfolio/utils'

type Props = { post: CollectionEntry<'blogs'> }

export async function getStaticPaths() {
  const localPosts = await getCollection('blogs')
  return localPosts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const props: Props = Astro.props
const post = props.post
const { Content, headings } = await render(post)
const data = post.data
const aiReplies = getAiReplies('blog', post.id) ?? []
const readingMinutes = estimateReadingMinutes(post.body ?? data.description)
const publishedAt = data.publishedAt.toISOString().slice(0, 10)
const updatedAt = data.updatedAt?.toISOString().slice(0, 10)
const dateLabel = publishedAt.replaceAll('-', '.')
const tocHeadings = headings.filter((heading) => heading.depth <= 3)
---

<BaseLayout
  title={`${data.title} — mumumu`}
  description={data.description}
  image={data.cover}
  imageAlt={data.coverAlt}
  type="article"
  publishedTime={publishedAt}
  updatedTime={updatedAt}
  schemaType="BlogPosting"
  tags={data.tags}
  readingMinutes={readingMinutes}
  breadcrumbs={[
    { name: 'ホーム', href: '/' },
    { name: 'ブログ', href: '/blog/' },
    { name: data.title, href: Astro.url.pathname },
  ]}
>
  <article class="article-page">
    <div class="reading-progress" data-reading-progress aria-hidden="true">
      <span data-reading-progress-label>0%</span>
    </div>
    <header class="article-header">
      <a class="article-back" href="/blog/">← Blog</a>
      <p class="eyebrow">MUMUMU'S BLOG</p>
      <h1>{data.title}</h1>
      <p class="article-lead">{data.description}</p>
      <div class="article-meta">
        <time datetime={publishedAt}>{dateLabel}</time>
        <span>約{readingMinutes}分</span>
        <TagList tags={data.tags} />
      </div>
    </header>

    <ResponsiveImage
      className="article-cover"
      src={data.cover}
      sizes="(max-width: 760px) calc(100vw - 32px), 780px"
      alt={data.coverAlt}
      loading="eager"
      fetchPriority="high"
    />

    <ArticleToc headings={tocHeadings} mode="mobile" />

    <div class="article-layout">
      <ArticleToc headings={tocHeadings} mode="desktop" />
      <div class="article-prose"><Content /></div>
    </div>

    {
      aiReplies.length > 0 && (
        <section
          class="article-comments"
          aria-labelledby="article-comments-title"
        >
          <div class="article-comments__head">
            <p class="eyebrow">MARGIN NOTES</p>
            <h2 id="article-comments-title">AIのコメント</h2>
          </div>
          <ReplyDisclosure replies={aiReplies} label="コメント" open />
        </section>
      )
    }
  </article>
</BaseLayout>

<script>
  let progressFrame = 0

  const updateReadingProgress = () => {
    progressFrame = 0
    const article = document.querySelector<HTMLElement>('.article-page')
    const ring = document.querySelector<HTMLElement>('[data-reading-progress]')
    if (!article || !ring) return

    const start = article.offsetTop
    const end = Math.max(
      start + article.offsetHeight - window.innerHeight,
      start + 1,
    )
    const progress = Math.min(
      1,
      Math.max(0, (window.scrollY - start) / (end - start)),
    )
    ring.style.setProperty('--reading-progress', `${progress * 360}deg`)

    document
      .querySelectorAll<HTMLElement>('[data-reading-progress-label]')
      .forEach((label) => {
        label.textContent = `${Math.round(progress * 100)}%`
      })

    const headings = [
      ...article.querySelectorAll<HTMLElement>(
        '.article-prose h2, .article-prose h3',
      ),
    ]
    const current = headings
      .filter((heading) => heading.getBoundingClientRect().top <= 150)
      .at(-1)
    document
      .querySelectorAll<HTMLAnchorElement>('.article-toc a')
      .forEach((link) => {
        const active = current
          ? link.hash === `#${encodeURIComponent(current.id)}`
          : false
        link.classList.toggle('active', active)
        if (active) link.setAttribute('aria-current', 'location')
        else link.removeAttribute('aria-current')
      })
  }

  const scheduleReadingProgress = () => {
    if (progressFrame) return
    progressFrame = requestAnimationFrame(updateReadingProgress)
  }

  window.addEventListener('scroll', scheduleReadingProgress, { passive: true })
  window.addEventListener('resize', scheduleReadingProgress)
  document.addEventListener('astro:page-load', scheduleReadingProgress)
  scheduleReadingProgress()
</script>
