---
import BaseLayout from '@/components/shell/BaseLayout.astro'
import TimelineEntry from '@/features/timeline/TimelineEntry.astro'
import TimelineIndex from '@/features/timeline/TimelineIndex.astro'
import TimelineSection from '@/features/timeline/TimelineSection.astro'
import { getExperiences } from '@/data/portfolio/timeline'
import { groupEntriesByPeriod } from '@/lib/portfolio/utils'

const experiences = await getExperiences()
const experienceGroups = groupEntriesByPeriod(experiences, (entry) =>
  entry.date.slice(0, 4),
)
const latestLabel = experiences[0]?.dateLabel ?? '—'
const timelineGroups = experienceGroups.map(([year, entries]) => ({
  id: `experience-${year}`,
  label: year,
  count: entries.length,
}))
---

<BaseLayout
  title="活動・経験 | mumumu"
  description="mumumuの活動と経験のタイムライン。"
  schemaType="CollectionPage"
>
  <div class="experience-layout">
    <TimelineIndex
      eyebrow="EXPERIENCE INDEX"
      latestLabel={latestLabel}
      groups={timelineGroups}
      total={experiences.length}
      navLabel="年別の経歴"
    />

    <div class="experience-stream">
      {experienceGroups.map(([year, entries]) => (
        <TimelineSection
          id={`experience-${year}`}
          headingId={`experience-${year}-heading`}
          label={year}
          count={entries.length}
        >
          {entries.map((entry) => (
            <TimelineEntry entry={entry} headingLevel={3} />
          ))}
        </TimelineSection>
      ))}
    </div>
  </div>
</BaseLayout>
