---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/layout/PageIntro.astro';
import FeedEntry from '@/components/feed/FeedEntry.astro';
import TimelineIndex from '@/components/layout/TimelineIndex.astro';
import TimelineSection from '@/components/layout/TimelineSection.astro';
import { experiences } from '@/lib/portfolio/timeline';
import { groupEntriesByPeriod } from '@/lib/portfolio/utils';

const experienceGroups = groupEntriesByPeriod(experiences, (entry) => entry.date.slice(0, 4));
const latestLabel = experiences[0]?.dateLabel ?? '—';
const timelineGroups = experienceGroups.map(([year, entries]) => ({
  id: `experience-${year}`,
  label: year,
  count: entries.length,
}));
---

<BaseLayout
  title="活動・経験 | mumumu"
  description="mumumuの活動と経験のタイムライン。"
  schemaType="CollectionPage"
  shell="wide"
>
  <PageIntro
    eyebrow="ALONG THE WAY"
    title="Experience"
    description="活動の節目を、新しいものから順にまとめています。"
  />
  <div class="experience-layout">
    <TimelineIndex
      eyebrow="EXPERIENCE INDEX"
      latestLabel={latestLabel}
      groups={timelineGroups}
      total={experiences.length}
      navLabel="年別の経歴"
    />

    <div class="experience-stream">
      {experienceGroups.map(([year, entries]) => (
        <TimelineSection
          id={`experience-${year}`}
          headingId={`experience-${year}-heading`}
          label={year}
          count={entries.length}
        >
          {entries.map((entry) => <FeedEntry entry={entry} headingLevel={3} />)}
        </TimelineSection>
      ))}
    </div>
  </div>
</BaseLayout>
