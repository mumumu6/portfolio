---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import FeedEntry from '../components/FeedEntry.astro';
import { experiences } from '../data/content';

const groupedExperiences = experiences.reduce<Record<string, typeof experiences>>((groups, entry) => {
  const year = entry.date.slice(0, 4);
  (groups[year] ??= []).push(entry);
  return groups;
}, {});
const experienceGroups = Object.entries(groupedExperiences).sort(([a], [b]) => b.localeCompare(a));
const latestLabel = experiences[0]?.dateLabel ?? '—';
---

<BaseLayout
  title="活動・経験 | mumumu"
  description="mumumuの活動と経験のタイムライン。"
  schemaType="CollectionPage"
  shell="wide"
>
  <PageIntro
    eyebrow="ALONG THE WAY"
    title="Experience"
    description="新しいものから順に、140字くらいで読める活動の記録。詳しい話は返信のように続きます。"
  />
  <div class="experience-layout">
    <aside class="experience-index">
      <p class="eyebrow">EXPERIENCE INDEX</p>
      <p class="experience-index__latest"><span>LATEST</span><strong>{latestLabel}</strong></p>
      <nav aria-label="年別の経歴">
        {experienceGroups.map(([year, entries]) => (
          <a href={`#experience-${year}`}>
            <span>{year}</span>
            <i aria-hidden="true"></i>
            <strong>{String(entries.length).padStart(2, '0')}</strong>
          </a>
        ))}
      </nav>
      <p class="experience-index__total">{experiences.length} records</p>
    </aside>

    <div class="experience-stream">
      {experienceGroups.map(([year, entries]) => (
        <section class="experience-year" id={`experience-${year}`} aria-labelledby={`experience-${year}-heading`}>
          <h2 class="experience-year__heading" id={`experience-${year}-heading`}>
            <span>{year}</span><small>{entries.length} {entries.length === 1 ? 'entry' : 'entries'}</small>
          </h2>
          <div class="feed-list feed-list--timeline">
            {entries.map((entry) => <FeedEntry entry={entry} />)}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
