---
import BaseLayout from '@/layouts/BaseLayout.astro'
import TimelineEntry from '@/components/feed/TimelineEntry.astro'
import TimelineIndex from '@/components/layout/TimelineIndex.astro'
import TimelineSection from '@/components/layout/TimelineSection.astro'
import { groupEntriesByPeriod } from '@/repository/utils'
import { experienceRepository } from '@/repository/astro/experience'
import styles from '@/styles/components/timeline.module.css'

const experiences = await experienceRepository.listExperiences()
const experienceGroups = groupEntriesByPeriod(experiences, (entry) =>
  entry.date.slice(0, 4),
)
const latestLabel = experiences[0]?.dateLabel ?? '—'
const timelineGroups = experienceGroups.map(([year, entries]) => ({
  id: `experience-${year}`,
  label: year,
  count: entries.length,
}))
---

<BaseLayout
  title="活動・経験 | mumumu"
  description="mumumuの活動と経験のタイムライン。"
  schemaType="CollectionPage"
>
  <div class={styles.experienceLayout}>
    <TimelineIndex
      eyebrow="EXPERIENCE INDEX"
      latestLabel={latestLabel}
      groups={timelineGroups}
      total={experiences.length}
      navLabel="年別の経歴"
    />

    <div class={styles.experienceStream}>
      {experienceGroups.map(([year, entries]) => (
        <TimelineSection
          id={`experience-${year}`}
          headingId={`experience-${year}-heading`}
          label={year}
          count={entries.length}
        >
          {entries.map((entry) => (
            <TimelineEntry entry={entry} headingLevel={3} />
          ))}
        </TimelineSection>
      ))}
    </div>
  </div>
</BaseLayout>
