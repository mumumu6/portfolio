---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProfileHeader from '@/components/profile/ProfileHeader.astro';
import FeedEntry from '@/components/feed/FeedEntry.astro';
import WorkEntry from '@/components/feed/WorkEntry.astro';
import SectionHeading from '@/components/layout/SectionHeading.astro';
import { blogPosts } from '@/lib/portfolio/blogs';
import { works } from '@/lib/portfolio/works';
---

<BaseLayout
  title="mumumuのポートフォリオ"
  description="mumumuのポートフォリオ。制作物、技術記事、活動記録を掲載しています。"
  schemaType="ProfilePage"
>
  <ProfileHeader />

  <section aria-labelledby="works-heading">
    <SectionHeading id="works-heading" eyebrow="SELECTED PROJECTS" title="Works" href="/works/" />

    <div class="feed-list feed-list--compact">
      {works.slice(0, 2).map((entry, index) => <WorkEntry entry={entry} headingLevel={3} priority={index === 0} />)}
    </div>
  </section>

  <section aria-labelledby="blog-heading">
    <SectionHeading id="blog-heading" eyebrow="LATEST WRITING" title="Blog" href="/blog/" />

    <div class="feed-list feed-list--compact">
      {blogPosts.slice(0, 3).map((entry) => <FeedEntry entry={entry} headingLevel={3} />)}
    </div>
  </section>
</BaseLayout>
