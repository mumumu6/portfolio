---
import BaseLayout from '@/layouts/BaseLayout.astro'
import BlogCard from '@/components/feed/BlogCard.astro'
import WorkCard from '@/components/feed/WorkCard.astro'
import SectionHeading from '@/components/layout/SectionHeading.astro'
import feedStyles from '@/styles/components/feed.module.css'
import { blogRepository } from '@/repository/astro/blog'
import { workRepository } from '@/repository/astro/work'

const blogPosts = await blogRepository.listPosts()
const works = await workRepository.listWorks()
---

<BaseLayout
  title="mumumuのポートフォリオ"
  description="mumumuのポートフォリオ。制作物、技術記事、活動記録を掲載しています。"
  schemaType="ProfilePage"
>
  <section aria-labelledby="works-heading">
    <SectionHeading
      id="works-heading"
      eyebrow="SELECTED PROJECTS"
      title="Works"
      href="/works/"
    />

    <div class={feedStyles.feedListCompact}>
      {works.slice(0, 2).map((entry, index) => (
        <WorkCard entry={entry} headingLevel={3} priority={index === 0} />
      ))}
    </div>
  </section>

  <section aria-labelledby="blog-heading">
    <SectionHeading
      id="blog-heading"
      eyebrow="LATEST WRITING"
      title="Blog"
      href="/blog/"
    />

    <div class={feedStyles.feedListCompact}>
      {blogPosts.slice(0, 3).map((entry) => (
        <BlogCard entry={entry} headingLevel={3} />
      ))}
    </div>
  </section>
</BaseLayout>
