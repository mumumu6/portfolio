---
import '@/styles/components/ai-disclosure.css'
import BaseLayout from '@/layouts/BaseLayout.astro'
import TimelineEntry from '@/components/feed/TimelineEntry.astro'
import TimelineIndex from '@/components/layout/TimelineIndex.astro'
import TimelineSection from '@/components/layout/TimelineSection.astro'
import { thoughts } from '@/lib/portfolio/ai'
import { groupEntriesByPeriod } from '@/lib/portfolio/utils'

const thoughtGroups = groupEntriesByPeriod(thoughts, (entry) =>
  entry.date.slice(0, 7),
)
const latestLabel = thoughts[0]?.dateLabel ?? '—'
const timelineGroups = thoughtGroups.map(([month, entries]) => ({
  id: `thoughts-${month}`,
  label: month.replace('-', '.'),
  count: entries.length,
}))
---

<BaseLayout
  title="AI日記 Thoughts | mumumu"
  description="AIがmumumuの活動ログをもとに書く、AI日記。"
  schemaType="CollectionPage"
  shell="adaptive"
>
  <div class="experience-layout">
    <TimelineIndex
      eyebrow="THOUGHTS INDEX"
      latestLabel={latestLabel}
      groups={timelineGroups}
      total={thoughts.length}
      navLabel="月別のThoughts"
    />

    <div class="experience-stream">
      {
        thoughtGroups.map(([month, entries]) => (
          <TimelineSection
            id={`thoughts-${month}`}
            headingId={`thoughts-${month}-heading`}
            label={month.replace('-', '.')}
            count={entries.length}
            listClass="feed-list--thoughts"
          >
            {entries.map((entry) => (
              <TimelineEntry entry={entry} headingLevel={3} />
            ))}
          </TimelineSection>
        ))
      }
    </div>
  </div>

  <aside class="ai-disclosure" aria-label="AI生成について">
    <strong>このページについて</strong>
    <p>
      投稿と返信はChatGPT・CodexのログをもとにAIで生成し、公開前に本人が確認しています。
    </p>
  </aside>
</BaseLayout>

<script>
  const handleThoughtsIndexClick = (event: MouseEvent) => {
    if (
      event.defaultPrevented ||
      event.button !== 0 ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey
    ) {
      return
    }

    const clicked = event.target
    if (!(clicked instanceof Element)) return
    const link = clicked.closest<HTMLAnchorElement>('.experience-index nav a')
    if (
      !link ||
      !link.hash ||
      link.origin !== location.origin ||
      link.pathname !== location.pathname
    ) {
      return
    }

    const section = document.getElementById(
      decodeURIComponent(link.hash.slice(1)),
    )
    if (!section) return

    event.preventDefault()
    history.pushState({ ...history.state }, '', `${link.pathname}${link.hash}`)
    section.scrollIntoView({ behavior: 'auto', block: 'start' })
  }

  document.addEventListener('click', handleThoughtsIndexClick, {
    capture: true,
  })
</script>
