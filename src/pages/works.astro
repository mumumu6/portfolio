---
import BaseLayout from '@/components/shell/BaseLayout.astro'
import WorkCard from '@/features/works/WorkCard.astro'
import { works } from '@/lib/content/works'
---

<BaseLayout
  title="制作物・プロジェクト | mumumu"
  description="mumumuが制作したWebサイト、アプリ、開発プロジェクトの一覧。技術構成や制作時に考えたことも紹介します。"
  schemaType="CollectionPage"
>
  <div class="feed-list feed-list--compact">
    {works.map((entry, index) => (
      <WorkCard entry={entry} priority={index === 0} />
    ))}
  </div>
</BaseLayout>
