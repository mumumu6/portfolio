---
import BaseLayout from '@/layouts/BaseLayout.astro'
import WorkCard from '@/components/feed/WorkCard.astro'
import { works } from '@/lib/portfolio/works'
---

<BaseLayout
  title="制作物・プロジェクト | mumumu"
  description="mumumuが制作したWebサイト、アプリ、開発プロジェクトの一覧。技術構成や制作時に考えたことも紹介します。"
  schemaType="CollectionPage"
  shell="adaptive"
>
  <div class="feed-list feed-list--compact">
    {
      works.map((entry, index) => (
        <WorkCard entry={entry} priority={index === 0} />
      ))
    }
  </div>
</BaseLayout>
