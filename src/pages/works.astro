---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/layout/PageIntro.astro';
import WorkEntry from '@/components/feed/WorkEntry.astro';
import { works } from '@/lib/portfolio/works';
---

<BaseLayout
  title="制作物・プロジェクト | mumumu"
  description="mumumuが制作したWebサイト、アプリ、開発プロジェクトの一覧。技術構成や制作時に考えたことも紹介します。"
  schemaType="CollectionPage"
  shell="adaptive"
>
  <PageIntro
    eyebrow="BUILT THINGS"
    title="Works"
    description="作ったものと、そのとき考えていたこと。制作メモと一緒に記録しています。"
  />
  <div class="feed-list feed-list--compact">
    {works.map((entry, index) => <WorkEntry entry={entry} priority={index === 0} />)}
  </div>
</BaseLayout>
