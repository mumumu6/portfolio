---
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import '@/styles/components/work-detail.css'
import '@/styles/components/article-prose.css'
import '@/styles/components/eyebrow.css'
import '@/styles/components/work-status.css'
import BaseLayout from '@/components/shell/BaseLayout.astro'
import { getAiReplies } from '@/lib/content/ai'
import { statusLabels } from '@/lib/portfolio/constants'
import { buildWorkThreadItems } from '@/lib/portfolio/work-thread'
import WorkThreadRoot from '@/features/works/WorkThreadRoot.astro'
import WorkThreadReply from '@/features/works/WorkThreadReply.astro'
import WorkProjectDetails from '@/features/works/WorkProjectDetails.astro'

export const getStaticPaths = async () => {
  const works = await getCollection('works')
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }))
}

type Props = { work: CollectionEntry<'works'> }
const { work }: Props = Astro.props
const { Content } = await render(work)
const data = work.data
const publishedAt = data.publishedAt.toISOString().slice(0, 10)
const dateLabel = publishedAt.slice(0, 7).replace('-', '.')
const statusLabel = statusLabels[data.status]
const threadItems = buildWorkThreadItems(
  data.comments,
  (await getAiReplies('work', work.id)) ?? [],
  data.publishedAt,
)
---

<BaseLayout
  title={`${data.title} — Works — mumumu`}
  description={data.summary}
  image={data.cover.src}
  imageAlt={data.cover.alt}
  type="article"
  profileHeadingLevel={2}
  publishedTime={publishedAt}
  schemaType="CreativeWork"
  tags={data.tags}
  breadcrumbs={[
    { name: 'ホーム', href: '/' },
    { name: '作品', href: '/works/' },
    { name: data.title, href: Astro.url.pathname },
  ]}
>
  <article class="work-thread-page">
    <WorkThreadRoot
      work={work}
      publishedAt={publishedAt}
      dateLabel={dateLabel}
      statusLabel={statusLabel}
    />

    {threadItems.map((item, index) => {
      return (
        <WorkThreadReply
          item={item}
          index={index}
          isLast={index === threadItems.length - 1}
        />
      )
    })}

    <WorkProjectDetails data={data}>
      <Content />
    </WorkProjectDetails>
  </article>
</BaseLayout>
