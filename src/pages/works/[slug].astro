---
import { entryTransitionName } from '@/lib/entry-transition'
import styles from '@/styles/components/work-detail.module.css'
import proseStyles from '@/styles/components/article-prose.module.css'
import eyebrowStyles from '@/styles/components/eyebrow.module.css'
import statusStyles from '@/styles/components/work-status.module.css'
import Avatar from '@/components/common/Avatar.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ExternalLinkCard from '@/components/common/ExternalLinkCard.astro'
import ResponsiveImage from '@/components/common/ResponsiveImage.astro'
import { authorNames, formatReplyDate } from '@/repository/authors'
import { workRepository, type WorkDocument } from '@/repository/astro/work'
import { statusLabels } from '@/repository/work'
import { aiContentRepository } from '@/repository/astro/ai'
import type { AuthorId, Reply } from '@/repository/shared'

export const getStaticPaths = async () => {
  const works = await workRepository.listDocuments()
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }))
}

type Props = { work: WorkDocument }
const { work }: Props = Astro.props
const { Content } = await workRepository.renderDocument(work)
const transitionHref = `/works/${work.id}/`
const data = work.data
const publishedAt = data.publishedAt.toISOString().slice(0, 10)
const dateLabel = publishedAt.slice(0, 7).replace('-', '.')
const statusLabel = statusLabels[data.status]
const aiReplies = (await aiContentRepository.getReplies('work', work.id)) ?? []
const makerReplies = [
  ...data.comments.map((comment) =>
    Object.assign({}, comment, { date: comment.date ?? data.publishedAt }),
  ),
]
type ThreadItem =
  | {
      kind: 'maker'
      author: 'mumumu'
      body: string
      label: string
      date: string
      replyTo?: undefined
      sourceOrder: number
    }
  | {
      kind: 'ai'
      author: Reply['author']
      body: string
      label?: undefined
      date: string
      replyTo: AuthorId | undefined
      sourceOrder: number
    }
const threadItems = [
  ...makerReplies.map<ThreadItem>((reply, index) => ({
    kind: 'maker',
    author: 'mumumu',
    body: reply.body,
    label: reply.label,
    date: reply.date.toISOString().slice(0, 10),
    sourceOrder: index,
  })),
  ...aiReplies.map<ThreadItem>((reply, index) => ({
    kind: 'ai',
    author: reply.author,
    body: reply.body,
    label: undefined,
    date: reply.createdAt ?? publishedAt,
    replyTo: reply.replyTo,
    sourceOrder: makerReplies.length + index,
  })),
].toSorted(
  (a, b) => a.date.localeCompare(b.date) || a.sourceOrder - b.sourceOrder,
)
---

<BaseLayout
  title={`${data.title} — Works — mumumu`}
  description={data.summary}
  image={data.cover.src}
  imageAlt={data.cover.alt}
  type="article"
  publishedTime={publishedAt}
  schemaType="CreativeWork"
  tags={data.tags}
  markdownUrl={`/works/${work.id}.md`}
  breadcrumbs={[
    { name: 'ホーム', href: '/' },
    { name: '作品', href: '/works/' },
    { name: data.title, href: Astro.url.pathname },
  ]}
>
  <article class={styles.workThreadPage}>
    <section
      class:list={[styles.workThreadPost, styles.workThreadPostRoot]}
      aria-labelledby="work-title"
    >
      <div class={styles.workThreadRail}>
        <Avatar author="mumumu" />
        <span class={styles.workThreadLine} aria-hidden="true"></span>
      </div>
      <div class={styles.workThreadContent}>
        <header class={styles.workThreadHead} data-work-thread-head>
          <strong>mumumu</strong>
          <span aria-hidden="true">·</span>
          <time datetime={publishedAt}>{dateLabel}</time>
          <span aria-hidden="true">·</span>
          <span class={statusStyles.workStatus}>{statusLabel}</span>
        </header>
        <h1
          id="work-title"
          data-entry-title
          style={`view-transition-name: ${entryTransitionName(transitionHref, 'title')}`}
        >
          {data.title}
        </h1>
        <p class={styles.workThreadSummary}>{data.summary}</p>
        <ResponsiveImage
          className={styles.workThreadCover}
          transitionName={entryTransitionName(transitionHref, 'image')}
          workCover
          src={data.cover.src}
          alt={data.cover.alt}
          sizes="(max-width: 760px) calc(100vw - 92px), 680px"
          loading="eager"
          fetchPriority="high"
        />
        <footer class={styles.workThreadMeta}>
          <span>{data.tags.join(' / ')}</span>
        </footer>
        {data.links.length > 0 && (
          <nav class={styles.workThreadLinks} aria-label="作品へのリンク">
            {data.links.map((link) => (
              <ExternalLinkCard href={link.href} label={link.label} />
            ))}
          </nav>
        )}
      </div>
    </section>

    {threadItems.map((item, index) => {
      const replyDate = formatReplyDate(item.date)
      return (
        <section
          class:list={[styles.workThreadPost, styles.workThreadPostReply]}
          data-work-thread-post="reply"
          aria-label={
            item.kind === 'ai'
              ? `${authorNames[item.author]}のコメント ${index + 1}`
              : `mumumuの${item.label} ${index + 1}`
          }
        >
          <div class={styles.workThreadRail}>
            <Avatar author={item.author} />
            {index < threadItems.length - 1 && (
              <span class={styles.workThreadLine} aria-hidden="true" />
            )}
          </div>
          <div class={styles.workThreadContent}>
            <header class={styles.workThreadHead} data-work-thread-head>
              <strong>{authorNames[item.author]}</strong>
              {item.kind === 'maker' && <span>{item.label}</span>}
              {replyDate && (
                <>
                  <span aria-hidden="true">·</span>
                  <time datetime={item.date}>{replyDate}</time>
                </>
              )}
            </header>
            {item.replyTo && (
              <p data-work-thread-reply-context>
                {authorNames[item.replyTo]}への返信
              </p>
            )}
            <p>{item.body}</p>
          </div>
        </section>
      )
    })}

    <section class={styles.workDetails} aria-labelledby="work-details-title">
      <header class={styles.workDetailsHead}>
        <p class={eyebrowStyles.eyebrow}>PROJECT NOTES</p>
        <h2 id="work-details-title">作品について</h2>
      </header>
      <div class={styles.workDetailsBody}>
        <div
          class:list={[proseStyles.articleProse, styles.workThreadProse]}
          data-article-prose
        >
          <Content />
        </div>

        {data.highlights.length > 0 && (
          <div class={styles.workThreadHighlights}>
            <p class={eyebrowStyles.eyebrow}>WHAT IT DOES</p>
            <ul>
              {data.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          </div>
        )}

        {data.warning && (
          <aside class={styles.workThreadWarning}>
            <strong>更新状況</strong>
            <p>{data.warning}</p>
          </aside>
        )}

        {data.gallery.map((image) => (
          <figure class={styles.workThreadGallery}>
            <ResponsiveImage
              className={styles.workThreadGalleryImage}
              src={image.src}
              alt={image.alt}
              sizes="(max-width: 760px) calc(100vw - 84px), 680px"
            />
            {image.caption && <figcaption>{image.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>
